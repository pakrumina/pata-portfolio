---
import { TESTIMONIALS_ITEMS, TESTIMONIALS_PROOF, TESTIMONIALS_TITLE } from '../consts';

const first = TESTIMONIALS_ITEMS[0];
---

<section class="testimonials" id="testimonials" aria-label="Testimonials">
	<div class="testimonials__inner">
		<header class="testimonials__header">
			<h2 class="testimonials__title">
				<span class="testimonials__title-lead" data-testimonials-reveal>{TESTIMONIALS_TITLE.lead}</span>
				<span class="testimonials__title-main" data-testimonials-reveal>{TESTIMONIALS_TITLE.main}</span>
			</h2>
			<div class="testimonials__proof">
				<div class="testimonials__avatars" aria-hidden="true">
					{
						TESTIMONIALS_ITEMS.map((item) => (
							<img class="testimonials__avatar" src={item.image} alt="" />
						))
					}
				</div>
				<p class="testimonials__rating">
					<span class="testimonials__star" aria-hidden="true">
						<svg viewBox="0 0 16 16" fill="currentColor">
							<path d="M8 1.2 9.9 5.7l4.9.4-3.7 3.2 1.1 4.8L8 11.8l-4.2 2.3 1.1-4.8L1.2 6.1l4.9-.4L8 1.2Z"></path>
						</svg>
					</span>
					{TESTIMONIALS_PROOF}
				</p>
			</div>
		</header>

		<div class="testimonials__stage" data-testimonials-stage>
			<script type="application/json" data-testimonials-data is:inline set:html={JSON.stringify(TESTIMONIALS_ITEMS)} />

			<div class="testimonials__photos" aria-hidden="true">
				{
					TESTIMONIALS_ITEMS.map((item, index) => (
						<img
							class:list={['testimonials__photo', { 'is-active': index === 0 }]}
							src={item.image}
							alt=""
							data-testimonials-photo
						/>
					))
				}
			</div>

			<div class="testimonials__controls">
				<div class="testimonials__index" aria-hidden="true">
					<div class="testimonials__index-viewport" data-index-stage>
						<span class="testimonials__line-mask">
							<span class="testimonials__line" data-line-current>01</span>
							<span class="testimonials__line testimonials__line--next" data-line-next></span>
						</span>
					</div>
				</div>

				<div class="testimonials__nav">
					<button
						class="testimonials__arrow"
						type="button"
						data-testimonials-next
						aria-label="Next testimonial"
					>
						<span class="testimonials__arrow-icon" aria-hidden="true">
							<svg viewBox="0 0 16 16" fill="none">
								<path
									d="M8 3.25v9.5M4.25 8.75 8 12.5l3.75-3.75"
									stroke="currentColor"
									stroke-width="1.4"
									stroke-linecap="round"
									stroke-linejoin="round"
								></path>
							</svg>
						</span>
					</button>
					<button
						class="testimonials__arrow"
						type="button"
						data-testimonials-prev
						aria-label="Previous testimonial"
					>
						<span class="testimonials__arrow-icon" aria-hidden="true">
							<svg viewBox="0 0 16 16" fill="none">
								<path
									d="M8 12.75V3.25M4.25 7.25 8 3.5l3.75 3.75"
									stroke="currentColor"
									stroke-width="1.4"
									stroke-linecap="round"
									stroke-linejoin="round"
								></path>
							</svg>
						</span>
					</button>
				</div>
			</div>

			<div class="testimonials__copy">
				<p class="testimonials__live" data-testimonials-live aria-live="polite">
					{first.name}. {first.quote}
				</p>
				<div class="testimonials__copy-viewport">
					<div class="testimonials__quote" data-quote-stage data-quote-sample>
						<span class="testimonials__line-mask">
							<span class="testimonials__line" data-line-current>“{first.quote}”</span>
							<span class="testimonials__line testimonials__line--next" data-line-next></span>
						</span>
					</div>
					<div class="testimonials__person" data-person-stage>
						<span class="testimonials__line-mask">
							<span class="testimonials__line" data-line-current>{first.name} | {first.role}</span>
							<span class="testimonials__line testimonials__line--next" data-line-next></span>
						</span>
					</div>
					<div class="testimonials__place" data-place-stage>
						<span class="testimonials__line-mask">
							<span class="testimonials__line" data-line-current>{first.company} | {first.location}</span>
							<span class="testimonials__line testimonials__line--next" data-line-next></span>
						</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.testimonials {
		width: 100%;
		padding-block: 4rem 8rem;
		background-color: var(--color-bg);
	}

	.testimonials__inner {
		width: 100%;
		max-width: 100rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	.testimonials__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.testimonials__title {
		display: flex;
		flex-direction: column;
		margin: 0;
		min-width: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 3.375rem;
		line-height: 1;
		letter-spacing: -0.06rem;
	}

	.testimonials__title-main {
		color: #737373;
	}

	.testimonials__title :global(.testimonials-reveal-line) {
		padding-bottom: 0.08em;
	}

	.testimonials__proof {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex: 0 0 auto;
		gap: 0.65rem;
		padding-bottom: 0.08em;
	}

	.testimonials__avatars {
		display: flex;
		align-items: center;
	}

	.testimonials__avatar {
		display: block;
		width: 2.25rem;
		height: 2.25rem;
		object-fit: cover;
		object-position: center;
		border: 0.0625rem solid #3a3a3a;
		border-radius: 999rem;
		background-color: #1a1a1a;
	}

	.testimonials__avatar:not(:first-child) {
		margin-inline-start: -0.7rem;
	}

	.testimonials__rating {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin: 0;
		color: #737373;
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.75rem;
		line-height: 1;
		letter-spacing: -0.01rem;
		white-space: nowrap;
	}

	.testimonials__star {
		display: grid;
		flex: 0 0 auto;
		place-items: center;
		width: 0.7rem;
		height: 0.7rem;
	}

	.testimonials__star svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.testimonials__stage {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: center;
		column-gap: 1rem;
		row-gap: 2.5rem;
		width: 100%;
		margin-top: 3rem;
	}

	.testimonials__photos {
		position: relative;
		width: 100%;
		max-width: none;
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: 1.25rem;
		background-color: #111;
	}

	.testimonials__photo {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0;
	}

	.testimonials__photo.is-active {
		opacity: 1;
	}

	.testimonials__controls {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
	}

	.testimonials__index {
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 4.5rem;
		line-height: 1;
		letter-spacing: -0.08rem;
		opacity: 0.1;
	}

	.testimonials__index-viewport {
		position: relative;
		overflow: hidden;
		min-width: 2ch;
		padding-block: 0.08em;
	}

	.testimonials__nav {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.testimonials__arrow {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 0.0625rem solid rgb(245 245 245 / 0.28);
		border-radius: 999rem;
		background: transparent;
		color: var(--color-fg);
		cursor: pointer;
	}

	.testimonials__arrow:hover,
	.testimonials__arrow:focus-visible {
		border-color: rgb(245 245 245 / 0.7);
		outline: none;
	}

	.testimonials__arrow-icon {
		display: grid;
		place-items: center;
		width: 0.9rem;
		height: 0.9rem;
	}

	.testimonials__arrow-icon svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.testimonials__copy {
		position: relative;
		min-width: 0;
		width: 100%;
		grid-column: 1 / -1;
		text-align: left;
	}

	.testimonials__live {
		position: absolute;
		width: 0.0625rem;
		height: 0.0625rem;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	.testimonials__copy-viewport {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		width: 100%;
		min-width: 0;
		text-align: left;
	}

	.testimonials__quote {
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 1.25rem;
		line-height: 1.35;
		letter-spacing: -0.02rem;
	}

	.testimonials__person,
	.testimonials__place {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
	}

	.testimonials__person {
		color: var(--color-fg);
		font-weight: 600;
	}

	.testimonials__place {
		color: #737373;
		font-weight: 500;
	}

	@media (min-width: 48rem) {
		.testimonials {
			padding-block: 5rem 8rem;
		}

		.testimonials__title {
			font-size: 6.5rem;
			letter-spacing: -0.12rem;
		}

		.testimonials__avatar {
			width: 2.75rem;
			height: 2.75rem;
		}

		.testimonials__avatar:not(:first-child) {
			margin-inline-start: -0.8rem;
		}

		.testimonials__rating {
			font-size: 0.8125rem;
		}

		.testimonials__star {
			width: 0.75rem;
			height: 0.75rem;
		}

		.testimonials__stage {
			grid-template-columns: auto minmax(7.5rem, 1fr) minmax(0, 1fr);
			gap: 1.5rem 1rem;
			align-items: center;
			margin-top: 4rem;
		}

		.testimonials__photos {
			width: 20rem;
			max-width: none;
		}

		.testimonials__controls {
			justify-self: center;
		}

		.testimonials__copy {
			grid-column: auto;
			justify-self: stretch;
		}

		.testimonials__index {
			font-size: 6.25rem;
			letter-spacing: -0.12rem;
		}

		.testimonials__quote {
			font-size: 0.75rem;
		}

		.testimonials__person,
		.testimonials__place {
			font-size: 1rem;
		}
	}

	@media (min-width: 64rem) {
		.testimonials__inner {
			padding-inline: 2rem;
		}

		.testimonials {
			padding-block: 6rem 10rem;
		}

		.testimonials__title {
			font-size: 8.75rem;
			letter-spacing: -0.24rem;
		}

		.testimonials__avatar {
			width: 3rem;
			height: 3rem;
		}

		.testimonials__rating {
			font-size: 0.875rem;
		}

		.testimonials__stage {
			grid-template-columns: auto minmax(9rem, 1fr) minmax(0, 1fr);
			gap: 2rem 1.5rem;
			margin-top: 5rem;
		}

		.testimonials__photos {
			width: 24rem;
		}

		.testimonials__index {
			font-size: 8.75rem;
			letter-spacing: -0.18rem;
		}

		.testimonials__arrow {
			width: 2.75rem;
			height: 2.75rem;
		}

		.testimonials__quote {
			font-size: 1.75rem;
			letter-spacing: -0.03rem;
		}

		.testimonials__person,
		.testimonials__place {
			font-size: 1.0625rem;
		}
	}
</style>

<style is:global>
	.testimonials .testimonials__line-mask {
		display: block;
		position: relative;
		overflow: hidden;
	}

	.testimonials .testimonials__line {
		display: block;
		will-change: transform;
	}

	.testimonials .testimonials__line--next {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
	}

	.testimonials .testimonials__stage.is-ready .testimonials__line-mask {
		height: 1lh;
	}

	.testimonials .testimonials__stage.is-ready .testimonials__line {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		white-space: nowrap;
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	type Testimonial = {
		quote: string;
		name: string;
		role: string;
		company: string;
		location: string;
		image: string;
	};

	let destroyTestimonialsMotion: (() => void) | undefined;

	function padIndex(index: number) {
		return String(index + 1).padStart(2, '0');
	}

	function quoted(item: Testimonial) {
		return `“${item.quote}”`;
	}

	function personLine(item: Testimonial) {
		return `${item.name} | ${item.role}`;
	}

	function placeLine(item: Testimonial) {
		return `${item.company} | ${item.location}`;
	}

	type LineRow = {
		mask: HTMLElement;
		current: HTMLElement;
		next: HTMLElement;
		expand: boolean;
		collapse: boolean;
	};

	function measureLines(text: string, sample: HTMLElement) {
		const width = sample.getBoundingClientRect().width;
		if (width < 1) return [text];

		const styles = getComputedStyle(sample);
		const probe = sample.cloneNode(false) as HTMLElement;
		probe.textContent = text;
		probe.setAttribute('aria-hidden', 'true');
		probe.style.cssText = '';
		probe.style.position = 'absolute';
		probe.style.visibility = 'hidden';
		probe.style.pointerEvents = 'none';
		probe.style.left = '0';
		probe.style.top = '0';
		probe.style.width = `${width}px`;
		probe.style.height = 'auto';
		probe.style.whiteSpace = 'normal';
		probe.style.fontFamily = styles.fontFamily;
		probe.style.fontSize = styles.fontSize;
		probe.style.fontWeight = styles.fontWeight;
		probe.style.letterSpacing = styles.letterSpacing;
		probe.style.lineHeight = styles.lineHeight;
		probe.style.overflowWrap = styles.overflowWrap;
		probe.style.wordBreak = styles.wordBreak;
		sample.parentElement?.appendChild(probe);

		const split = SplitText.create(probe, { type: 'lines', aria: 'none', autoSplit: false });
		const lines = split.lines
			.map((line) => (line.textContent || '').replace(/\s+/g, ' ').trim())
			.filter(Boolean);

		split.revert();
		probe.remove();
		return lines.length > 0 ? lines : [text];
	}

	function getAstroScope() {
		const host = document.querySelector('.testimonials');
		if (!(host instanceof HTMLElement)) return null;
		return [...host.attributes].find((attr) => attr.name.startsWith('data-astro-cid'))?.name ?? null;
	}

	function stampScope(el: HTMLElement, scope: string | null) {
		if (scope) el.setAttribute(scope, '');
	}

	function createMask(currentText: string) {
		const scope = getAstroScope();
		const mask = document.createElement('span');
		mask.className = 'testimonials__line-mask';
		stampScope(mask, scope);

		const current = document.createElement('span');
		current.className = 'testimonials__line';
		current.setAttribute('data-line-current', '');
		current.textContent = currentText;
		stampScope(current, scope);

		const next = document.createElement('span');
		next.className = 'testimonials__line testimonials__line--next';
		next.setAttribute('data-line-next', '');
		next.setAttribute('aria-hidden', 'true');
		stampScope(next, scope);

		mask.append(current, next);
		return mask;
	}

	function paintStage(stage: HTMLElement, lines: string[]) {
		const nextLines = lines.length > 0 ? lines : ['\u00A0'];
		gsap.killTweensOf(stage.querySelectorAll('.testimonials__line, .testimonials__line-mask'));
		stage.replaceChildren(...nextLines.map((line) => createMask(line)));
		gsap.set(stage.querySelectorAll('[data-line-current], [data-line-next]'), { y: 0, yPercent: 0 });
	}

	function stageLines(stage: HTMLElement) {
		return Array.from(stage.querySelectorAll<HTMLElement>('.testimonials__line-mask')).map((mask) => ({
			mask,
			current: mask.querySelector<HTMLElement>('[data-line-current]')!,
			next: mask.querySelector<HTMLElement>('[data-line-next]')!,
		}));
	}

	function syncStage(stage: HTMLElement, currentLines: string[], nextLines: string[]): LineRow[] {
		const count = Math.max(currentLines.length, nextLines.length, 1);
		let rows = stageLines(stage);

		while (rows.length < count) {
			stage.appendChild(createMask('\u00A0'));
			rows = stageLines(stage);
		}

		rows.slice(count).forEach((row) => row.mask.remove());

		return rows.slice(0, count).map((row, i) => {
			row.current.textContent = currentLines[i] || '\u00A0';
			row.next.textContent = nextLines[i] || '\u00A0';
			return {
				...row,
				expand: !currentLines[i] && Boolean(nextLines[i]),
				collapse: Boolean(currentLines[i]) && !nextLines[i],
			};
		});
	}

	function slotTravel(stage: HTMLElement, direction: 1 | -1) {
		const styles = getComputedStyle(stage);
		const lineHeight = Number.parseFloat(styles.lineHeight);
		const fontSize = Number.parseFloat(styles.fontSize);
		const distance = Number.isFinite(lineHeight) && lineHeight > 0 ? lineHeight : fontSize;
		return distance * 1.42 * direction;
	}

	function initTestimonialsMotion() {
		destroyTestimonialsMotion?.();

		const cleanups: Array<() => void> = [];
		const mm = gsap.matchMedia();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const header = document.querySelector('.testimonials__header');
			const revealTargets = document.querySelectorAll('[data-testimonials-reveal]');

			if (!(header instanceof HTMLElement) || revealTargets.length === 0) {
				return;
			}

			const split = SplitText.create(revealTargets, {
				type: 'lines',
				mask: 'lines',
				autoSplit: true,
				aria: 'auto',
				linesClass: 'testimonials-reveal-line',
				onSplit(self) {
					return gsap.from(self.lines, {
						yPercent: 110,
						duration: 0.95,
						ease: 'power3.out',
						stagger: 0.12,
						scrollTrigger: {
							trigger: header,
							start: 'top 80%',
							once: true,
						},
					});
				},
			});

			return () => split.revert();
		});

		const stage = document.querySelector('[data-testimonials-stage]');
		const dataNode = document.querySelector('[data-testimonials-data]');
		const photos = gsap.utils.toArray<HTMLElement>('[data-testimonials-photo]');
		const quoteStage = document.querySelector('[data-quote-stage]');
		const personStage = document.querySelector('[data-person-stage]');
		const placeStage = document.querySelector('[data-place-stage]');
		const indexStage = document.querySelector('[data-index-stage]');
		const nextButton = document.querySelector('[data-testimonials-next]');
		const prevButton = document.querySelector('[data-testimonials-prev]');
		const live = document.querySelector('[data-testimonials-live]');

		let items: Testimonial[] = [];

		try {
			items = JSON.parse(dataNode?.textContent ?? '[]') as Testimonial[];
		} catch {
			items = [];
		}

		if (
			stage instanceof HTMLElement &&
			quoteStage instanceof HTMLElement &&
			personStage instanceof HTMLElement &&
			placeStage instanceof HTMLElement &&
			indexStage instanceof HTMLElement &&
			nextButton instanceof HTMLButtonElement &&
			prevButton instanceof HTMLButtonElement &&
			photos.length === items.length &&
			items.length > 1
		) {
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const duration = reduceMotion ? 0 : 0.7;
			const lineStagger = 0.045;
			const wrap = gsap.utils.wrap(0, items.length);
			let activeIndex = 0;
			let busy = false;
			let pending: 1 | -1 | null = null;
			let resizeDirty = false;
			let activeTween: ReturnType<typeof gsap.timeline> | undefined;

			const layoutItem = (item: Testimonial) => ({
				quote: measureLines(quoted(item), quoteStage),
				person: measureLines(personLine(item), personStage),
				place: measureLines(placeLine(item), placeStage),
			});

			let currentLayout = layoutItem(items[0]);

			const paintCurrent = () => {
				paintStage(quoteStage, currentLayout.quote);
				paintStage(personStage, currentLayout.person);
				paintStage(placeStage, currentLayout.place);
				paintStage(indexStage, [padIndex(activeIndex)]);
				stage.classList.add('is-ready');
			};

			paintCurrent();

			void document.fonts?.ready.then(() => {
				if (busy) {
					resizeDirty = true;
					return;
				}
				currentLayout = layoutItem(items[activeIndex]);
				paintCurrent();
			});

			gsap.set(photos, { autoAlpha: 0, overwrite: true });
			gsap.set(photos[0], { autoAlpha: 1, overwrite: true });

			const finish = (nextIndex: number, nextItem: Testimonial, nextLayout: ReturnType<typeof layoutItem>) => {
				photos.forEach((photo, i) => photo.classList.toggle('is-active', i === nextIndex));
				currentLayout = nextLayout;
				activeIndex = nextIndex;
				if (live instanceof HTMLElement) {
					live.textContent = `${nextItem.name}. ${nextItem.quote}`;
				}
				busy = false;

				if (resizeDirty) {
					resizeDirty = false;
					currentLayout = layoutItem(items[activeIndex]);
					paintCurrent();
				}

				const queued = pending;
				pending = null;
				if (queued) goTo(queued);
			};

			function goTo(direction: 1 | -1) {
				if (busy) {
					pending = direction;
					return;
				}

				const nextIndex = wrap(activeIndex + direction);
				if (nextIndex === activeIndex) return;

				busy = true;
				const nextItem = items[nextIndex];
				const nextLayout = layoutItem(nextItem);

				if (reduceMotion) {
					paintStage(quoteStage, nextLayout.quote);
					paintStage(personStage, nextLayout.person);
					paintStage(placeStage, nextLayout.place);
					paintStage(indexStage, [padIndex(nextIndex)]);
					gsap.set(photos[activeIndex], { autoAlpha: 0, overwrite: true });
					gsap.set(photos[nextIndex], { autoAlpha: 1, overwrite: true });
					finish(nextIndex, nextItem, nextLayout);
					return;
				}

				const quoteRows = syncStage(quoteStage, currentLayout.quote, nextLayout.quote);
				const personRows = syncStage(personStage, currentLayout.person, nextLayout.person);
				const placeRows = syncStage(placeStage, currentLayout.place, nextLayout.place);
				const indexRows = syncStage(indexStage, [padIndex(activeIndex)], [padIndex(nextIndex)]);
				const groups = [
					{ stage: quoteStage, rows: quoteRows },
					{ stage: personStage, rows: personRows },
					{ stage: placeStage, rows: placeRows },
					{ stage: indexStage, rows: indexRows },
				];
				const rows = groups.flatMap((group) => {
					const travel = slotTravel(group.stage, direction);
					return group.rows.map((row) => ({ ...row, travel }));
				});

				rows.forEach((row) => {
					gsap.set(row.current, { y: 0, yPercent: 0 });
					gsap.set(row.next, { y: row.travel, yPercent: 0 });
					if (row.expand) gsap.set(row.mask, { height: 0 });
				});

				activeTween = gsap.timeline({
					defaults: { duration, ease: 'power3.inOut', overwrite: true },
					onComplete: () => {
						paintStage(quoteStage, nextLayout.quote);
						paintStage(personStage, nextLayout.person);
						paintStage(placeStage, nextLayout.place);
						paintStage(indexStage, [padIndex(nextIndex)]);
						finish(nextIndex, nextItem, nextLayout);
					},
				});

				const textSpan = duration + Math.max(0, rows.length - 1) * lineStagger;
				const photoDuration = textSpan * 1.2;

				activeTween
					.to(photos[activeIndex], { autoAlpha: 0, duration: photoDuration, ease: 'power2.inOut' }, 0)
					.to(photos[nextIndex], { autoAlpha: 1, duration: photoDuration, ease: 'power2.inOut' }, 0);

				rows.forEach((row, i) => {
					const at = i * lineStagger;
					if (row.expand) activeTween!.to(row.mask, { height: '1lh' }, at);
					activeTween!.to(row.current, { y: -row.travel }, at);
					activeTween!.to(row.next, { y: 0 }, at);
					if (row.collapse) activeTween!.to(row.mask, { height: 0 }, at);
				});
			}

			const onNext = () => goTo(1);
			const onPrev = () => goTo(-1);

			nextButton.addEventListener('click', onNext);
			prevButton.addEventListener('click', onPrev);

			const onResize = () => {
				if (busy) {
					resizeDirty = true;
					return;
				}
				currentLayout = layoutItem(items[activeIndex]);
				paintCurrent();
			};

			window.addEventListener('resize', onResize);

			cleanups.push(() => {
				activeTween?.kill();
				window.removeEventListener('resize', onResize);
				nextButton.removeEventListener('click', onNext);
				prevButton.removeEventListener('click', onPrev);
			});
		}

		destroyTestimonialsMotion = () => {
			mm.revert();
			cleanups.forEach((cleanup) => cleanup());
			destroyTestimonialsMotion = undefined;
		};
	}

	initTestimonialsMotion();
	document.addEventListener('astro:after-swap', initTestimonialsMotion);
</script>
