---
import {
	FOOTER_BACK_TO_TOP,
	FOOTER_BRAND,
	FOOTER_CREDIT,
	FOOTER_HEADLINE,
	FOOTER_META_LINKS,
	NAV_LINKS_LEFT,
	NAV_LINKS_RIGHT,
	SOCIAL_LINKS_LEFT,
	SOCIAL_LINKS_RIGHT,
} from '../consts';
import SocialGlyph from './SocialGlyph.astro';

const footerLinks = [...NAV_LINKS_LEFT, ...NAV_LINKS_RIGHT];
const socialLinks = [...SOCIAL_LINKS_LEFT, ...SOCIAL_LINKS_RIGHT];
const brandCopies = [0, 1, 2, 3];

function charsOf(label: string) {
	return [...label].map((char) => (char === ' ' ? '\u00A0' : char));
}
---

<footer class="footer" data-footer>
	<div class="footer__lead">
		<div class="footer__rule" aria-hidden="true"></div>
		<div class="footer__top">
			<div class="footer__intro">
				<p class="footer__headline" data-footer-headline>
					{FOOTER_HEADLINE.lead}<br />
					{FOOTER_HEADLINE.main} <span class="footer__headline-muted">{FOOTER_HEADLINE.muted}</span>
				</p>
				<nav class="footer__socials" aria-label="Social">
					{
						socialLinks.map((link) => (
							<a class="footer__social" href={link.href} aria-label={link.label} target="_blank" rel="noreferrer">
								<span class="footer__social-viewport">
									<span class="footer__social-track">
										<span class="footer__social-face">
											<SocialGlyph id={link.id} />
										</span>
										<span class="footer__social-face">
											<SocialGlyph id={link.id} />
										</span>
									</span>
								</span>
							</a>
						))
					}
				</nav>
			</div>
			<nav class="footer__nav" aria-label="Footer">
				{
					footerLinks.map((link) => (
						<a class="footer__link" href={link.href} data-footer-hover aria-label={link.label}>
							<span class="footer__link-mask" aria-hidden="true">
								{charsOf(link.label).map((char) => (
									<span class="footer__char-col">
										<span class="footer__char-track">
											<span class="footer__char">{char}</span>
											<span class="footer__char">{char}</span>
										</span>
									</span>
								))}
							</span>
						</a>
					))
				}
			</nav>
		</div>
	</div>

	<div class="footer__brand" aria-label="Craift Studio">
		<div class="footer__brand-viewport">
			<div class="footer__brand-track" data-footer-brand-track>
				{
					brandCopies.map((copy) => (
						<div
							class="footer__brand-set"
							data-footer-brand-set={copy === 0 ? true : undefined}
							aria-hidden={copy === 0 ? undefined : 'true'}
						>
							<p class="footer__brand-name">
								{FOOTER_BRAND}
								<span class="footer__brand-mark">©</span>
							</p>
						</div>
					))
				}
			</div>
		</div>
	</div>

	<div class="footer__meta">
		<p class="footer__credit">
			© {FOOTER_BRAND} — {FOOTER_CREDIT}
		</p>
		<nav class="footer__meta-nav" aria-label="Footer secondary">
			{
				FOOTER_META_LINKS.map((link) => (
					<a class="footer__meta-link" href={link.href}>
						{link.label}
					</a>
				))
			}
			<a class="footer__meta-link footer__back-top" href="#top" data-footer-top>
				{FOOTER_BACK_TO_TOP}
				<span class="footer__back-top-icon" aria-hidden="true">
					<svg viewBox="0 0 12 12" fill="none">
						<path
							d="M2.25 7.75 6 4.25l3.75 3.5"
							stroke="currentColor"
							stroke-width="1.25"
							stroke-linecap="round"
							stroke-linejoin="round"
						></path>
					</svg>
				</span>
			</a>
		</nav>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		width: 100%;
		overflow: hidden;
		padding: 4rem 0 1.25rem;
		background-color: var(--color-bg);
		color: var(--color-fg);
	}

	.footer__lead {
		width: 100%;
		max-width: 100rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	.footer__rule {
		width: 100%;
		height: 0.0625rem;
		margin-bottom: 8rem;
		background-color: rgb(245 245 245 / 0.08);
	}

	.footer__top {
		display: flex;
		flex-direction: column;
		gap: 3.25rem;
		width: 100%;
	}

	.footer__intro {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.75rem;
		min-width: 0;
	}

	.footer__headline {
		margin: 0;
		max-width: 22rem;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 1.75rem;
		line-height: 1.05;
		letter-spacing: -0.05rem;
	}

	.footer__headline :global(.footer-headline-line) {
		padding-bottom: 0.08em;
	}

	.footer__headline-muted {
		color: #737373;
	}

	.footer__socials {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.65rem;
	}

	.footer__social {
		--icon-size: 2.5rem;
		--glyph-size: 1.175rem;
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--icon-size);
		height: var(--icon-size);
		border: 0.08rem solid rgb(255 255 255 / 0.16);
		border-radius: 50%;
		background-color: rgb(255 255 255 / 8%);
		color: #fff;
		transition: background-color 0.2s ease;
	}

	.footer__social:hover,
	.footer__social:focus-visible {
		background-color: rgb(255 255 255 / 16%);
		outline: none;
	}

	.footer__social-viewport {
		display: block;
		overflow: hidden;
		width: var(--glyph-size);
		height: var(--glyph-size);
		min-height: 0;
	}

	.footer__social-track {
		display: flex;
		flex-direction: column;
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.footer__social:hover .footer__social-track,
	.footer__social:focus-visible .footer__social-track {
		transform: translateY(calc(-1 * var(--glyph-size)));
	}

	.footer__social-face {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 var(--glyph-size);
		width: var(--glyph-size);
		height: var(--glyph-size);
		overflow: hidden;
		color: #fff;
	}

	.footer__social :global(svg) {
		width: var(--glyph-size);
		height: var(--glyph-size);
	}

	.footer__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem 1.25rem;
	}

	.footer__link {
		display: inline-flex;
		align-items: center;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.9375rem;
		line-height: 1.2;
		letter-spacing: -0.01rem;
		text-decoration: none;
	}

	.footer__link-mask {
		display: inline-flex;
		overflow: hidden;
		height: 1.2em;
		line-height: 1.2;
	}

	.footer__char-col {
		display: block;
		overflow: hidden;
		height: 1.2em;
		line-height: 1.2;
	}

	.footer__char-track {
		display: flex;
		flex-direction: column;
		will-change: transform;
	}

	.footer__char {
		display: block;
		flex: 0 0 1.2em;
		height: 1.2em;
		line-height: 1.2;
	}

	.footer__brand {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
		margin-top: 5rem;
		min-height: 5.5rem;
	}

	.footer__brand-viewport {
		width: 100%;
		overflow: hidden;
	}

	.footer__brand-track {
		display: flex;
		align-items: baseline;
		width: max-content;
	}

	.footer__brand-set {
		flex: 0 0 auto;
		display: flex;
		align-items: baseline;
		padding-inline-end: 2.5rem;
	}

	.footer__brand-name {
		--brand-size: 4.5rem;
		flex: 0 0 auto;
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: var(--brand-size);
		line-height: 0.86;
		letter-spacing: -0.12rem;
		white-space: nowrap;
	}

	.footer__brand-mark {
		display: inline-block;
		margin-left: calc(var(--brand-size) * 0.08);
		font-size: calc(var(--brand-size) * 0.42);
		line-height: 1;
		vertical-align: super;
	}

	.footer__meta {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		width: 100%;
		max-width: 100rem;
		margin: 2rem auto 0;
		padding-inline: 1.25rem;
	}

	.footer__credit {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.75rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
	}

	.footer__meta-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
	}

	.footer__meta-link {
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.75rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
		text-decoration: none;
	}

	.footer__meta-link:hover,
	.footer__meta-link:focus-visible {
		color: var(--color-fg);
		outline: none;
	}

	.footer__back-top {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
	}

	.footer__back-top-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 0.7rem;
		height: 0.7rem;
	}

	.footer__back-top-icon svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	@media (prefers-reduced-motion: reduce) {
		.footer__social {
			transition: none;
		}

		.footer__social-track {
			transition: none;
		}

		.footer__social:hover .footer__social-track,
		.footer__social:focus-visible .footer__social-track {
			transform: none;
		}
	}

	@media (min-width: 48rem) {
		.footer {
			padding: 4rem 0 1.5rem;
		}

		.footer__lead {
			padding-inline: 2rem;
		}

		.footer__top {
			flex-direction: row;
			align-items: flex-start;
			justify-content: space-between;
			gap: 2rem;
		}

		.footer__headline {
			max-width: 28rem;
			font-size: 2.25rem;
			letter-spacing: -0.07rem;
		}

		.footer__social {
			--icon-size: 2.75rem;
		}

		.footer__nav {
			justify-content: flex-end;
			max-width: 28rem;
			gap: 0.9rem 1.5rem;
		}

		.footer__brand {
			margin-top: 5rem;
			min-height: 8.5rem;
		}

		.footer__brand-set {
			padding-inline-end: 3.5rem;
		}

		.footer__brand-name {
			--brand-size: 8.5rem;
			letter-spacing: -0.22rem;
		}

		.footer__meta {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: 1.5rem;
			margin-top: 2rem;
			padding-inline: 2rem;
		}
	}

	@media (min-width: 64rem) {
		.footer {
			padding: 4rem 0 1.75rem;
		}

		.footer__lead {
			padding-inline: 2.5rem;
		}

		.footer__headline {
			max-width: 34rem;
			font-size: 2.75rem;
			letter-spacing: -0.08rem;
		}

		.footer__nav {
			max-width: 36rem;
			gap: 1rem 1.75rem;
		}

		.footer__link {
			font-size: 1rem;
		}

		.footer__brand {
			margin-top: 5rem;
			min-height: 11rem;
		}

		.footer__brand-name {
			--brand-size: 13.5rem;
			letter-spacing: -0.32rem;
		}

		.footer__meta {
			padding-inline: 2.5rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	let destroyFooterMotion: (() => void) | undefined;

	function initFooter() {
		destroyFooterMotion?.();

		const footer = document.querySelector('[data-footer]');
		if (!(footer instanceof HTMLElement)) return;

		const backTop = footer.querySelector('[data-footer-top]');
		if (backTop instanceof HTMLAnchorElement) {
			backTop.addEventListener('click', (event) => {
				event.preventDefault();
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
				history.replaceState(null, '', `${window.location.pathname}${window.location.search}`);
			});
		}

		const mm = gsap.matchMedia();
		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const cleanups: Array<() => void> = [];

			const headline = footer.querySelector('[data-footer-headline]');

			if (headline instanceof HTMLElement) {
				const split = SplitText.create(headline, {
					type: 'lines',
					mask: 'lines',
					autoSplit: true,
					aria: 'auto',
					linesClass: 'footer-headline-line',
					onSplit(self) {
						return gsap.from(self.lines, {
							yPercent: 110,
							duration: 0.95,
							ease: 'power3.out',
							stagger: 0.12,
							scrollTrigger: {
								trigger: headline,
								start: 'top 80%',
								once: true,
							},
						});
					},
				});

				cleanups.push(() => split.revert());
			}

			const brandTrack = footer.querySelector('[data-footer-brand-track]');
			const brandSet = footer.querySelector('[data-footer-brand-set]');

			if (brandTrack instanceof HTMLElement && brandSet instanceof HTMLElement) {
				let brandTween: ReturnType<typeof gsap.to> | undefined;
				let brandWidth = 0;

				const playBrandMarquee = () => {
					const width = brandSet.getBoundingClientRect().width;
					if (width === 0 || Math.abs(width - brandWidth) < 0.5) return;

					brandWidth = width;
					brandTween?.kill();
					gsap.set(brandTrack, { x: 0 });
					brandTween = gsap.to(brandTrack, {
						x: `-=${width}`,
						duration: 18,
						ease: 'none',
						repeat: -1,
						force3D: true,
						modifiers: {
							x: gsap.utils.unitize((value) => parseFloat(value) % width),
						},
					});
				};

				playBrandMarquee();
				void document.fonts?.ready.then(playBrandMarquee);

				const brandObserver = new ResizeObserver(playBrandMarquee);
				brandObserver.observe(brandSet);

				cleanups.push(() => {
					brandObserver.disconnect();
					brandTween?.kill();
					gsap.set(brandTrack, { clearProps: 'transform' });
				});
			}

			footer.querySelectorAll('[data-footer-hover]').forEach((link) => {
				const tracks = link.querySelectorAll('.footer__char-track');
				if (tracks.length === 0) return;

				gsap.set(tracks, { yPercent: 0 });

				let hoverTl: ReturnType<typeof gsap.to> | undefined;

				const playHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: -50,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				const resetHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: 0,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				link.addEventListener('mouseenter', playHover);
				link.addEventListener('mouseleave', resetHover);
				link.addEventListener('focus', playHover);
				link.addEventListener('blur', resetHover);

				cleanups.push(() => {
					hoverTl?.kill();
					link.removeEventListener('mouseenter', playHover);
					link.removeEventListener('mouseleave', resetHover);
					link.removeEventListener('focus', playHover);
					link.removeEventListener('blur', resetHover);
				});
			});

			return () => {
				cleanups.forEach((cleanup) => cleanup());
			};
		});

		destroyFooterMotion = () => {
			mm.revert();
			destroyFooterMotion = undefined;
		};
	}

	initFooter();
	document.addEventListener('astro:after-swap', initFooter);
</script>
