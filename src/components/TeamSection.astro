---
import { TEAM_LINK, TEAM_MEMBERS, TEAM_TITLE } from '../consts';

function charsOf(label: string) {
	return [...label].map((char) => (char === ' ' ? '\u00A0' : char));
}
---

<section class="team" id="team" aria-label="Our team">
	<div class="team__inner">
		<header class="team__header">
			<h2 class="team__title">
				<span class="team__title-lead" data-team-reveal>{TEAM_TITLE.lead}</span>
				<span class="team__title-main" data-team-reveal>{TEAM_TITLE.main}</span>
			</h2>
			<a
				class="team__button"
				href={TEAM_LINK.href}
				data-team-link-hover
				aria-label={TEAM_LINK.label}
			>
				<span class="team__button-mask" aria-hidden="true">
					{
						charsOf(TEAM_LINK.label).map((char) => (
							<span class="team__char-col">
								<span class="team__char-track">
									<span class="team__char">{char}</span>
									<span class="team__char">{char}</span>
								</span>
							</span>
						))
					}
				</span>
			</a>
		</header>

		<div class="team__grid">
			{
				TEAM_MEMBERS.map((member) => (
					<article class="team__card">
						<img
							class="team__photo"
							src={member.image}
							alt={member.name}
							width="640"
							height="640"
						/>
						<h3 class="team__name">{member.name}</h3>
						<p class="team__role">{member.role}</p>
						<p class="team__text">{member.text}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.team {
		width: 100%;
		padding-block: 4rem 5rem;
		background-color: var(--color-bg);
	}

	.team__inner {
		width: 100%;
		max-width: 100rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	.team__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.team__title {
		display: flex;
		flex-direction: column;
		margin: 0;
		min-width: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 3.375rem;
		line-height: 1;
		letter-spacing: -0.06rem;
	}

	.team__title-main {
		color: #737373;
	}

	.team__title :global(.team-reveal-line) {
		padding-bottom: 0.08em;
	}

	.team__button {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		margin-bottom: 0.08em;
		padding: 0.9rem 1.6rem;
		border-radius: 999rem;
		background-color: #fff;
		color: #0a0a0a;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.9375rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
		text-decoration: none;
		isolation: isolate;
		transition: background-color 0.45s ease;
	}

	.team__button-mask {
		display: inline-flex;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.team__char-col {
		display: block;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.team__char-track {
		display: flex;
		flex-direction: column;
		will-change: transform;
	}

	.team__char {
		display: block;
		flex: 0 0 1.4em;
		height: 1.4em;
		line-height: 1.4;
	}

	.team__button:hover,
	.team__button:focus-visible {
		background-color: #f5f5f5;
		outline: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.team__button {
			transition: none;
		}
	}

	.team__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.85rem;
		margin-top: 3rem;
	}

	.team__card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-width: 0;
		height: 100%;
		padding: 1.35rem 1.35rem 1.5rem;
		border: 0.0625rem solid rgb(245 245 245 / 0.14);
		border-radius: 1.875rem;
		background-color: #111;
	}

	.team__photo {
		display: block;
		flex: 0 0 auto;
		width: 6.5rem;
		height: 6.5rem;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 1.25rem;
		background-color: #1a1a1a;
	}

	.team__name {
		margin: 1.15rem 0 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 1.25rem;
		line-height: 1.15;
		letter-spacing: -0.03rem;
	}

	.team__role {
		margin: 0.4rem 0 0;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.9375rem;
		line-height: 1.3;
		letter-spacing: -0.01rem;
	}

	.team__text {
		margin: 1.15rem 0 0;
		padding-top: 1.15rem;
		border-top: 0.0625rem solid rgb(245 245 245 / 0.12);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.9375rem;
		line-height: 1.55;
		letter-spacing: -0.01rem;
	}

	@media (min-width: 48rem) {
		.team {
			padding-block: 5rem 6rem;
		}

		.team__inner {
			padding-inline: 2rem;
		}

		.team__title {
			font-size: 6.5rem;
			letter-spacing: -0.12rem;
		}

		.team__button {
			padding: 1rem 1.85rem;
			font-size: 1rem;
		}

		.team__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1rem;
			margin-top: 4rem;
		}

		.team__card {
			padding: 1.5rem;
		}

		.team__photo {
			width: 7.25rem;
			height: 7.25rem;
		}
	}

	@media (min-width: 64rem) {
		.team {
			padding-block: 6rem 7rem;
		}

		.team__inner {
			padding-inline: 2.5rem;
		}

		.team__title {
			font-size: 8.75rem;
			letter-spacing: -0.24rem;
		}

		.team__button {
			padding: 1.05rem 2.1rem;
			font-size: 1.0625rem;
		}

		.team__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.team__card {
			padding: 1.75rem;
		}

		.team__photo {
			width: 8rem;
			height: 8rem;
		}

		.team__name {
			margin-top: 1.35rem;
			font-size: 1.375rem;
		}

		.team__text {
			margin-top: 1.35rem;
			padding-top: 1.35rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	let destroyTeamMotion: (() => void) | undefined;

	function initTeamMotion() {
		destroyTeamMotion?.();

		const mm = gsap.matchMedia();
		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const cleanups: Array<() => void> = [];
			const header = document.querySelector('.team__header');
			const revealTargets = document.querySelectorAll('[data-team-reveal]');

			if (header instanceof HTMLElement && revealTargets.length > 0) {
				const split = SplitText.create(revealTargets, {
					type: 'lines',
					mask: 'lines',
					autoSplit: true,
					aria: 'auto',
					linesClass: 'team-reveal-line',
					onSplit(self) {
						return gsap.from(self.lines, {
							yPercent: 110,
							duration: 0.95,
							ease: 'power3.out',
							stagger: 0.12,
							scrollTrigger: {
								trigger: header,
								start: 'top 80%',
								once: true,
							},
						});
					},
				});

				cleanups.push(() => split.revert());
			}

			document.querySelectorAll('[data-team-link-hover]').forEach((link) => {
				const tracks = link.querySelectorAll('.team__char-track');
				if (tracks.length === 0) return;

				gsap.set(tracks, { yPercent: 0 });

				let hoverTl: ReturnType<typeof gsap.to> | undefined;

				const playHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: -50,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				const resetHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: 0,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				link.addEventListener('mouseenter', playHover);
				link.addEventListener('mouseleave', resetHover);
				link.addEventListener('focus', playHover);
				link.addEventListener('blur', resetHover);

				cleanups.push(() => {
					hoverTl?.kill();
					link.removeEventListener('mouseenter', playHover);
					link.removeEventListener('mouseleave', resetHover);
					link.removeEventListener('focus', playHover);
					link.removeEventListener('blur', resetHover);
				});
			});

			return () => {
				cleanups.forEach((cleanup) => cleanup());
			};
		});

		destroyTeamMotion = () => {
			mm.revert();
			destroyTeamMotion = undefined;
		};
	}

	initTeamMotion();
	document.addEventListener('astro:after-swap', initTeamMotion);
</script>
