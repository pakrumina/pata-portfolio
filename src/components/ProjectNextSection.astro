---
import { EXPLORE_NEXT_KICKER, EXPLORE_NEXT_TITLE } from '../consts';

interface Props {
	name: string;
	href: string;
}

const { name, href } = Astro.props;

function charsOf(label: string) {
	return [...label].map((char) => (char === ' ' ? '\u00A0' : char));
}
---

<section class="next" id="explore-next" aria-label="Explore next project" data-next>
	<div class="next__frame">
		<div class="next__rule" aria-hidden="true"></div>
		<div class="next__inner">
			<p class="next__kicker">
				<span class="next__kicker-mark" aria-hidden="true">✦</span>
				{EXPLORE_NEXT_KICKER}
				<span class="next__kicker-mark" aria-hidden="true">✦</span>
			</p>
			<h2 class="next__title">
				<span class="next__title-lead" data-next-reveal>{EXPLORE_NEXT_TITLE.lead}</span>
				<span class="next__title-main" data-next-reveal>{EXPLORE_NEXT_TITLE.main}</span>
			</h2>
			<a class="next__button" href={href} data-next-link-hover aria-label={`Explore next: ${name}`}>
				<span class="next__button-mask" aria-hidden="true">
					{
						charsOf(name).map((char) => (
							<span class="next__char-col">
								<span class="next__char-track">
									<span class="next__char">{char}</span>
									<span class="next__char">{char}</span>
								</span>
							</span>
						))
					}
				</span>
			</a>
		</div>
	</div>
</section>

<style>
	.next {
		width: 100%;
		padding-block: 4.5rem 6rem;
		background-color: var(--color-bg);
	}

	.next__frame {
		width: 100%;
		max-width: 100rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	.next__rule {
		width: 100%;
		height: 0.0625rem;
		background-color: rgb(245 245 245 / 0.08);
	}

	.next__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		width: 100%;
		margin-top: 4.5rem;
		text-align: center;
	}

	.next__kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0.65rem 0.85rem;
		border: 0.0625rem solid rgb(255 255 255 / 0.16);
		border-radius: 999rem;
		background-color: rgb(255 255 255 / 0.06);
		color: #fff;
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.625rem;
		line-height: 1;
		letter-spacing: 0.08rem;
		text-transform: uppercase;
	}

	.next__kicker-mark {
		font-size: 0.55rem;
		line-height: 1;
	}

	.next__title {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 3.375rem;
		line-height: 0.95;
		letter-spacing: -0.06rem;
		text-align: center;
	}

	.next__title-main {
		color: #737373;
	}

	.next__title :global(.next-reveal-line) {
		padding-bottom: 0.08em;
	}

	.next__button {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		padding: 0.9rem 1.6rem;
		border-radius: 999rem;
		background-color: #000;
		color: #fff;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.9375rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
		text-decoration: none;
		isolation: isolate;
		transition: background-color 0.45s ease;
	}

	.next__button-mask {
		display: inline-flex;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.next__char-col {
		display: block;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.next__char-track {
		display: flex;
		flex-direction: column;
		will-change: transform;
	}

	.next__char {
		display: block;
		flex: 0 0 1.4em;
		height: 1.4em;
		line-height: 1.4;
	}

	.next__button:hover,
	.next__button:focus-visible {
		background-color: #2e2e2e;
		outline: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.next__button {
			transition: none;
		}
	}

	@media (min-width: 48rem) {
		.next {
			padding-block: 5.5rem 7.5rem;
		}

		.next__frame {
			padding-inline: 2rem;
		}

		.next__inner {
			gap: 1.75rem;
			margin-top: 5.5rem;
		}

		.next__kicker {
			font-size: 0.75rem;
		}

		.next__title {
			font-size: 6.5rem;
			letter-spacing: -0.12rem;
		}

		.next__button {
			padding: 1rem 1.85rem;
			font-size: 1rem;
		}
	}

	@media (min-width: 64rem) {
		.next {
			padding-block: 6.5rem 9rem;
		}

		.next__frame {
			padding-inline: 2.5rem;
		}

		.next__inner {
			gap: 2rem;
			margin-top: 6.5rem;
		}

		.next__title {
			font-size: 8.75rem;
			letter-spacing: -0.24rem;
		}

		.next__button {
			padding: 1.05rem 2.1rem;
			font-size: 1.0625rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	let destroyNextMotion: (() => void) | undefined;

	function initNextMotion() {
		destroyNextMotion?.();

		const section = document.querySelector('[data-next]');
		if (!(section instanceof HTMLElement)) return;

		const mm = gsap.matchMedia();
		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const cleanups: Array<() => void> = [];
			const title = section.querySelector('.next__title');
			const revealTargets = section.querySelectorAll('[data-next-reveal]');

			if (title instanceof HTMLElement && revealTargets.length > 0) {
				const split = SplitText.create(revealTargets, {
					type: 'lines',
					mask: 'lines',
					autoSplit: true,
					aria: 'auto',
					linesClass: 'next-reveal-line',
					onSplit(self) {
						return gsap.from(self.lines, {
							yPercent: 110,
							duration: 0.95,
							ease: 'power3.out',
							stagger: 0.12,
							scrollTrigger: {
								trigger: title,
								start: 'top 80%',
								once: true,
							},
						});
					},
				});

				cleanups.push(() => split.revert());
			}

			section.querySelectorAll('[data-next-link-hover]').forEach((link) => {
				const tracks = link.querySelectorAll('.next__char-track');
				if (tracks.length === 0) return;

				gsap.set(tracks, { yPercent: 0 });

				let hoverTl: ReturnType<typeof gsap.to> | undefined;

				const playHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: -50,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				const resetHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: 0,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				link.addEventListener('mouseenter', playHover);
				link.addEventListener('mouseleave', resetHover);
				link.addEventListener('focus', playHover);
				link.addEventListener('blur', resetHover);

				cleanups.push(() => {
					hoverTl?.kill();
					link.removeEventListener('mouseenter', playHover);
					link.removeEventListener('mouseleave', resetHover);
					link.removeEventListener('focus', playHover);
					link.removeEventListener('blur', resetHover);
				});
			});

			return () => {
				cleanups.forEach((cleanup) => cleanup());
			};
		});

		destroyNextMotion = () => {
			mm.revert();
			destroyNextMotion = undefined;
		};
	}

	initNextMotion();
	document.addEventListener('astro:after-swap', initNextMotion);
</script>
