---
import {
	ABOUT_DESCRIPTION,
	ABOUT_HEADLINE,
	ABOUT_LINK,
	ABOUT_STATS,
} from '../consts';

function charsOf(label: string) {
	return [...label].map((char) => (char === ' ' ? '\u00A0' : char));
}

function reelForChar(char: string) {
	if (!/^\d$/.test(char)) {
		return { items: ['\u00A0', char], restIndex: 1 };
	}

	const target = Number(char);
	const items: string[] = [];
	const extraSpins = 2;

	for (let spin = 0; spin < extraSpins; spin++) {
		for (let n = 0; n <= 9; n++) items.push(String(n));
	}

	for (let n = 0; n <= target; n++) items.push(String(n));

	return { items, restIndex: items.length - 1 };
}
---

<section class="about" id="about" aria-label="About">
	<div class="about__inner">
		<div class="about__intro">
			<h2 class="about__headline" data-about-headline>
				{ABOUT_HEADLINE.lead}<span class="about__headline-muted">{ABOUT_HEADLINE.muted}</span>
			</h2>
			<div class="about__aside">
				<p class="about__text">{ABOUT_DESCRIPTION}</p>
				<a
					class="about__link"
					href={ABOUT_LINK.href}
					data-about-link-hover
					aria-label={ABOUT_LINK.label}
				>
					<span class="about__link-mask" aria-hidden="true">
						{
							charsOf(ABOUT_LINK.label).map((char) => (
								<span class="about__char-col">
									<span class="about__char-track">
										<span class="about__char">{char}</span>
										<span class="about__char">{char}</span>
									</span>
								</span>
							))
						}
					</span>
					<span class="about__link-arrow" aria-hidden="true">↗</span>
					<span class="about__link-underline" aria-hidden="true">
						<span class="about__link-underline-fill"></span>
					</span>
				</a>
			</div>
		</div>

		<dl class="about__stats">
			{
				ABOUT_STATS.map((stat) => (
					<div class="about__stat">
						<dt class="about__stat-label">{stat.label}</dt>
						<dd class="about__stat-value">
							<span class="about__stat-sr">{stat.value}</span>
							<span class="about__stat-reels" aria-hidden="true">
								{
									[...stat.value].map((char) => {
										const reel = reelForChar(char);
										return (
											<span class:list={['about__digit-col', char === '+' && 'about__digit-col--plus']}>
												<span
													class="about__digit-track"
													data-stat-track
													data-reel-index={reel.restIndex}
													data-reel-count={reel.items.length}
													style={`--reel-index: ${reel.restIndex}; --reel-count: ${reel.items.length}; --reel-shift: 0;`}
												>
													{reel.items.map((item) => (
														<span class="about__digit">{item}</span>
													))}
												</span>
											</span>
										);
									})
								}
							</span>
						</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.about {
		width: 100%;
		padding-block: 8rem 5rem;
		background-color: var(--color-bg);
	}

	.about__inner {
		width: 100%;
		max-width: 100rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	.about__intro {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 2.5rem;
		width: 100%;
		margin-bottom: 3.5rem;
	}

	.about__headline {
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 1.75rem;
		line-height: 1.2;
		letter-spacing: -0.03rem;
	}

	.about__headline :global(.about-headline-line) {
		padding-bottom: 0.08em;
	}

	.about__headline-muted {
		color: #737373;
	}

	.about__aside {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.about__text {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 1rem;
		line-height: 1.55;
		letter-spacing: -0.01rem;
	}

	.about__link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		width: fit-content;
		border-bottom: 0.0625rem solid rgb(245 245 245 / 0.35);
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 1rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
		text-decoration: none;
	}

	.about__link-mask {
		display: inline-flex;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.about__char-col {
		display: block;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.about__char-track {
		display: flex;
		flex-direction: column;
		will-change: transform;
	}

	.about__char {
		display: block;
		flex: 0 0 1.4em;
		height: 1.4em;
		line-height: 1.4;
	}

	.about__link-underline {
		position: absolute;
		right: 0;
		bottom: -0.0625rem;
		left: 0;
		height: 0.0625rem;
		overflow: hidden;
		pointer-events: none;
	}

	.about__link-underline-fill {
		display: block;
		width: 100%;
		height: 100%;
		background-color: #fff;
		transform: translateX(-100%);
		transition: transform 0.45s ease;
	}

	.about__link:hover .about__link-underline-fill,
	.about__link:focus-visible .about__link-underline-fill {
		transform: translateX(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.about__link-underline-fill {
			transition: none;
		}
	}

	.about__link-arrow {
		font-size: 0.9rem;
		line-height: 1;
	}

	.about__stats {
		display: flex;
		flex-direction: column;
		width: 100%;
		margin: 0;
	}

	.about__stat {
		display: flex;
		align-items: start;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		padding-block: 1.75rem;
		border-top: 0.0625rem solid rgb(245 245 245 / 0.12);
	}

	.about__stat:last-child {
		border-bottom: 0.0625rem solid rgb(245 245 245 / 0.12);
	}

	.about__stat-label {
		margin: 0;
		padding-top: 0.35rem;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 1rem;
		line-height: 1.2;
		letter-spacing: -0.01rem;
	}

	.about__stat-value {
		position: relative;
		margin: 0 0 0 auto;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 3.375rem;
		line-height: 1;
		letter-spacing: -0.06rem;
		font-variant-numeric: tabular-nums;
		text-align: right;
	}

	.about__stat-sr {
		position: absolute;
		width: 0.0625rem;
		height: 0.0625rem;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	.about__stat-reels {
		display: flex;
		justify-content: flex-end;
		align-items: flex-start;
	}

	.about__digit-col {
		display: block;
		overflow: hidden;
		width: 0.62em;
		height: 1em;
		line-height: 1;
		margin-inline-end: -0.06em;
		transform: translateZ(0);
	}

	.about__digit-col:last-child {
		margin-inline-end: 0;
	}

	.about__digit-col--plus {
		color: #737373;
	}

	.about__digit-track {
		display: flex;
		flex-direction: column;
		will-change: transform;
		transform: translateY(calc(var(--reel-shift, 0) * -1em));
	}

	.about__digit {
		display: flex;
		flex: 0 0 1em;
		align-items: center;
		justify-content: center;
		height: 1em;
		line-height: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.about__digit-track {
			--reel-shift: var(--reel-index);
			will-change: auto;
		}
	}

	@media (min-width: 48rem) {
		.about {
			padding-block: 8rem;
		}

		.about__intro {
			margin-bottom: 5rem;
		}

		.about__headline {
			font-size: 3rem;
		}

		.about__text {
			font-size: 1.125rem;
		}

		.about__link {
			font-size: 1.125rem;
		}

		.about__stats {
			margin-top: 0;
		}

		.about__stat {
			padding-block: 2.25rem;
		}

		.about__stat-label {
			font-size: 1.125rem;
		}

		.about__stat-value {
			font-size: 8rem;
			letter-spacing: -0.3rem;
		}

		.about__digit-col {
			margin-inline-end: -0.03em;
		}
	}

	@media (min-width: 64rem) {
		.about__inner {
			padding-inline: 2rem;
		}

		.about__intro {
			flex-direction: row;
			align-items: flex-start;
			justify-content: space-between;
			gap: 4rem;
			margin-bottom: 6rem;
		}

		.about__headline {
			flex: 1 1 0;
			min-width: 0;
			max-width: 58rem;
			font-size: 3.5rem;
		}

		.about__aside {
			flex: 0 0 22rem;
			width: 22rem;
			max-width: 22rem;
			margin-inline-start: auto;
		}

		.about__stat-value {
			font-size: 10rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	let destroyAboutMotion: (() => void) | undefined;

	function initAboutMotion() {
		destroyAboutMotion?.();

		const mm = gsap.matchMedia();
		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const cleanups: Array<() => void> = [];

			const section = document.querySelector('#about');
			const headline = document.querySelector('[data-about-headline]');

			if (section instanceof HTMLElement && headline instanceof HTMLElement) {
				const split = SplitText.create(headline, {
					type: 'lines',
					mask: 'lines',
					autoSplit: true,
					aria: 'auto',
					linesClass: 'about-headline-line',
					onSplit(self) {
						return gsap.from(self.lines, {
							yPercent: 110,
							duration: 0.95,
							ease: 'power3.out',
							stagger: 0.12,
							scrollTrigger: {
								trigger: section,
								start: 'top 80%',
								once: true,
							},
						});
					},
				});

				cleanups.push(() => split.revert());
			}

			const stats = document.querySelector('.about__stats');

			if (stats instanceof HTMLElement) {
				const rows = stats.querySelectorAll('.about__stat');
				const tl = gsap.timeline({
					defaults: { ease: 'power3.inOut' },
					scrollTrigger: {
						trigger: stats,
						start: 'top 80%',
						once: true,
					},
				});

				rows.forEach((row, rowIndex) => {
					const tracks = row.querySelectorAll<HTMLElement>('[data-stat-track]');

					tracks.forEach((track, charIndex) => {
						const restIndex = Number(track.dataset.reelIndex);

						if (!Number.isFinite(restIndex)) {
							return;
						}

						gsap.set(track, { clearProps: 'transform', '--reel-shift': 0 });

						tl.fromTo(
							track,
							{ '--reel-shift': 0 },
							{
								'--reel-shift': restIndex,
								duration: 3.6,
							},
							rowIndex * 0.36 + charIndex * 0.16,
						);
					});
				});
			}

			document.querySelectorAll('[data-about-link-hover]').forEach((link) => {
				const tracks = link.querySelectorAll('.about__char-track');
				if (tracks.length === 0) return;

				gsap.set(tracks, { yPercent: 0 });

				let hoverTl: ReturnType<typeof gsap.to> | undefined;

				const playHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: -50,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				const resetHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: 0,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				link.addEventListener('mouseenter', playHover);
				link.addEventListener('mouseleave', resetHover);
				link.addEventListener('focus', playHover);
				link.addEventListener('blur', resetHover);

				cleanups.push(() => {
					hoverTl?.kill();
					link.removeEventListener('mouseenter', playHover);
					link.removeEventListener('mouseleave', resetHover);
					link.removeEventListener('focus', playHover);
					link.removeEventListener('blur', resetHover);
				});
			});

			return () => {
				cleanups.forEach((cleanup) => cleanup());
			};
		});

		destroyAboutMotion = () => {
			mm.revert();
			destroyAboutMotion = undefined;
		};
	}

	initAboutMotion();
	document.addEventListener('astro:after-swap', initAboutMotion);
</script>
