---
import {
	PRICING_ASK,
	PRICING_CTA,
	PRICING_FAQS,
	PRICING_PLANS,
	PRICING_PROOF,
	PRICING_TITLE,
} from '../consts';

function charsOf(label: string) {
	return [...label].map((char) => (char === ' ' ? '\u00A0' : char));
}
---

<section class="pricing" id="pricing" aria-label="Pricing">
	<div class="pricing__inner">
		<header class="pricing__header">
			<h2 class="pricing__title">
				<span class="pricing__title-lead" data-pricing-reveal>{PRICING_TITLE.lead}</span>
				<span class="pricing__title-main" data-pricing-reveal>{PRICING_TITLE.main}</span>
			</h2>
			<div class="pricing__proof">
				<p class="pricing__proof-value" data-pricing-reveal>{PRICING_PROOF.value}</p>
				<p class="pricing__proof-label" data-pricing-reveal>{PRICING_PROOF.label}</p>
			</div>
		</header>

		<div class="pricing__layout">
			{
				PRICING_PLANS.map((plan) => (
					<article class="pricing__plan">
						<div class="pricing__plan-top">
							<div class="pricing__plan-head">
								<p class="pricing__plan-name">
									<span class="pricing__plan-mark" aria-hidden="true">
										✦
									</span>
									{plan.name}
								</p>
								<span class="pricing__plan-badge">{plan.badge}</span>
							</div>
							<p class="pricing__plan-price">
								{plan.price}
								<span class="pricing__plan-unit">{plan.unit}</span>
							</p>
							<p class="pricing__plan-text">{plan.description}</p>
						</div>

						<div class="pricing__plan-features">
							<p class="pricing__features-label">Features:</p>
							<ul class="pricing__features">
								{plan.features.map((feature) => (
									<li class="pricing__feature">
										<span class="pricing__check" aria-hidden="true">
											<svg viewBox="0 0 20 20" fill="none">
												<circle cx="10" cy="10" r="8.25" stroke="currentColor" stroke-width="1.2"></circle>
												<path
													d="M6.5 10.2 8.7 12.4 13.5 7.6"
													stroke="currentColor"
													stroke-width="1.4"
													stroke-linecap="round"
													stroke-linejoin="round"
												></path>
											</svg>
										</span>
										<p class="pricing__feature-text">
											<strong>{feature.label}</strong> {feature.detail}
										</p>
									</li>
								))}
							</ul>
							<a
								class="pricing__cta"
								href={PRICING_CTA.href}
								data-pricing-link-hover
								aria-label={PRICING_CTA.label}
							>
								<span class="pricing__cta-mask" aria-hidden="true">
									{
										charsOf(PRICING_CTA.label).map((char) => (
											<span class="pricing__char-col">
												<span class="pricing__char-track">
													<span class="pricing__char">{char}</span>
													<span class="pricing__char">{char}</span>
												</span>
											</span>
										))
									}
								</span>
							</a>
						</div>
					</article>
				))
			}

			<aside class="pricing__aside">
				<div class="pricing__faqs">
					{
						PRICING_FAQS.map((faq, index) => (
							<div class="pricing__faq" data-pricing-faq>
								<button
									class="pricing__faq-trigger"
									type="button"
									aria-expanded="false"
									aria-controls={`pricing-faq-${index}`}
									data-faq-trigger
								>
									<span class="pricing__faq-question">
										{index + 1}. {faq.question}
									</span>
									<span class="pricing__faq-icon" aria-hidden="true" data-faq-icon>
										<span></span>
										<span></span>
									</span>
								</button>
								<div
									class="pricing__faq-panel"
									id={`pricing-faq-${index}`}
									data-faq-panel
								>
									<p class="pricing__faq-answer">{faq.answer}</p>
								</div>
							</div>
						))
					}
				</div>

				<div class="pricing__ask">
					<p class="pricing__ask-prompt">
						<span aria-hidden="true">✦</span>
						{PRICING_ASK.prompt}
					</p>
					<a
						class="pricing__ask-link"
						href={PRICING_ASK.link.href}
						data-pricing-link-hover
						aria-label={PRICING_ASK.link.label}
					>
						<span class="pricing__ask-mask" aria-hidden="true">
							{
								charsOf(PRICING_ASK.link.label).map((char) => (
									<span class="pricing__char-col">
										<span class="pricing__char-track">
											<span class="pricing__char">{char}</span>
											<span class="pricing__char">{char}</span>
										</span>
									</span>
								))
							}
						</span>
						<span class="pricing__ask-arrow" aria-hidden="true">↗</span>
						<span class="pricing__ask-underline" aria-hidden="true">
							<span class="pricing__ask-underline-fill"></span>
						</span>
					</a>
				</div>
			</aside>
		</div>
	</div>
</section>

<style>
	.pricing {
		width: 100%;
		padding-block: 4rem 8rem;
		background-color: var(--color-bg);
	}

	.pricing__inner {
		width: 100%;
		max-width: 100rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	.pricing__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.pricing__title {
		display: flex;
		flex-direction: column;
		margin: 0;
		min-width: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 3.375rem;
		line-height: 1;
		letter-spacing: -0.06rem;
	}

	.pricing__title-main {
		color: #737373;
	}

	.pricing__title :global(.pricing-reveal-line),
	.pricing__proof :global(.pricing-reveal-line) {
		padding-bottom: 0.08em;
	}

	.pricing__proof {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		flex: 0 0 auto;
		gap: 0.25rem;
		text-align: right;
	}

	.pricing__proof-value {
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 2.5rem;
		line-height: 0.9;
		letter-spacing: -0.1rem;
	}

	.pricing__proof-label {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.9375rem;
		line-height: 1.55;
		letter-spacing: -0.01rem;
	}

	.pricing__layout {
		display: grid;
		grid-template-columns: 1fr;
		align-items: stretch;
		gap: 0.85rem;
		margin-top: 3rem;
	}

	.pricing__plan {
		display: flex;
		flex-direction: column;
		min-width: 0;
		height: 100%;
		padding: 1.35rem 1.35rem 1.5rem;
		border: 0.0625rem solid rgb(245 245 245 / 0.14);
		border-radius: 1.875rem;
		background-color: #111;
	}

	.pricing__faq {
		border: 0.0625rem solid rgb(245 245 245 / 0.14);
		background-color: #111;
	}

	.pricing__plan-top {
		display: flex;
		flex-direction: column;
		gap: 1.35rem;
	}

	.pricing__plan-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.pricing__plan-name {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.875rem;
		line-height: 1;
		letter-spacing: 0.04rem;
		text-transform: uppercase;
	}

	.pricing__plan-mark {
		font-size: 0.7rem;
		line-height: 1;
	}

	.pricing__plan-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.4rem 0.75rem;
		border: 0.0625rem solid rgb(245 245 245 / 0.14);
		border-radius: 999rem;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.75rem;
		line-height: 1;
		letter-spacing: -0.01rem;
	}

	.pricing__plan-price {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 2.5rem;
		line-height: 0.9;
		letter-spacing: -0.1rem;
	}

	.pricing__plan-unit {
		color: #737373;
		font-weight: 500;
		font-size: 0.8125rem;
		line-height: 1;
		letter-spacing: 0.04rem;
		text-transform: uppercase;
	}

	.pricing__plan-text {
		margin: 0;
		max-width: 28rem;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.9375rem;
		line-height: 1.55;
		letter-spacing: -0.01rem;
	}

	.pricing__plan-features {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		gap: 1.15rem;
		margin-top: 1.85rem;
		padding-top: 1.85rem;
		border-top: 0.0625rem solid rgb(245 245 245 / 0.12);
	}

	.pricing__features-label {
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.9375rem;
		line-height: 1.3;
		letter-spacing: -0.01rem;
	}

	.pricing__features {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		margin: 0 0 1rem;
		padding: 0;
		list-style: none;
	}

	.pricing__feature {
		display: flex;
		align-items: flex-start;
		gap: 0.7rem;
	}

	.pricing__check {
		display: grid;
		flex: 0 0 auto;
		place-items: center;
		width: 1.15rem;
		height: 1.15rem;
		margin-top: 0.1rem;
		color: var(--color-fg);
	}

	.pricing__check svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.pricing__feature-text {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.9375rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
	}

	.pricing__feature-text strong {
		color: var(--color-fg);
		font-weight: 600;
	}

	.pricing__cta {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		margin-top: auto;
		padding: 0.95rem 1.25rem;
		border: 0.0625rem solid rgb(245 245 245 / 0.14);
		border-radius: 999rem;
		background-color: transparent;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.9375rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
		text-decoration: none;
		transition:
			background-color 0.45s ease,
			border-color 0.45s ease;
	}

	.pricing__cta-mask {
		display: inline-flex;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.pricing__cta:hover,
	.pricing__cta:focus-visible {
		border-color: rgb(245 245 245 / 0.28);
		background-color: rgb(245 245 245 / 0.045);
	}

	.pricing__aside {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 100%;
	}

	.pricing__faqs {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.pricing__faq {
		overflow: hidden;
		border-radius: 1.25rem;
		-webkit-tap-highlight-color: transparent;
	}

	.pricing__faq-trigger {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		padding: 1.525rem 1.25rem;
		border: 0;
		border-radius: inherit;
		background-color: #111;
		color: var(--color-fg);
		font-family: var(--font-sans);
		text-align: left;
		cursor: pointer;
		appearance: none;
		-webkit-appearance: none;
		-webkit-tap-highlight-color: transparent;
		touch-action: manipulation;
		transform: translateZ(0);
		-webkit-user-select: none;
		user-select: none;
	}

	.pricing__faq-trigger:hover,
	.pricing__faq-trigger:focus,
	.pricing__faq-trigger:focus-visible,
	.pricing__faq-trigger:active {
		background-color: #111;
		color: var(--color-fg);
		outline: none;
	}

	.pricing__faq-question {
		min-width: 0;
		font-weight: 600;
		font-size: 1.1875rem;
		line-height: 1.35;
		letter-spacing: 0.02rem;
		-webkit-font-smoothing: antialiased;
		transform: translateZ(0);
	}

	.pricing__faq-icon {
		position: relative;
		display: block;
		flex: 0 0 auto;
		width: 0.85rem;
		height: 0.85rem;
	}

	.pricing__faq-icon span {
		position: absolute;
		top: 50%;
		left: 0;
		width: 100%;
		height: 0.1rem;
		border-radius: 999rem;
		background-color: currentColor;
	}

	.pricing__faq-icon span:first-child {
		transform: translateY(-50%);
	}

	.pricing__faq-icon span:last-child {
		transform: translateY(-50%) rotate(90deg);
	}

	.pricing__faq-panel {
		height: 0;
		overflow: hidden;
	}

	.pricing__faq-answer {
		margin: 0;
		padding: 0 1.25rem 1.25rem;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.9375rem;
		line-height: 1.55;
		letter-spacing: -0.01rem;
	}

	.pricing__ask {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3.75rem;
	}

	.pricing__ask-prompt {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.875rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
	}

	.pricing__ask-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		width: fit-content;
		border-bottom: 0.0625rem solid rgb(245 245 245 / 0.35);
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 1rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
		text-decoration: none;
		text-transform: uppercase;
	}

	.pricing__ask-mask {
		display: inline-flex;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.pricing__char-col {
		display: block;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.pricing__char-track {
		display: flex;
		flex-direction: column;
		will-change: transform;
	}

	.pricing__char {
		display: block;
		flex: 0 0 1.4em;
		height: 1.4em;
		line-height: 1.4;
	}

	.pricing__ask-underline {
		position: absolute;
		right: 0;
		bottom: -0.0625rem;
		left: 0;
		height: 0.0625rem;
		overflow: hidden;
		pointer-events: none;
	}

	.pricing__ask-underline-fill {
		display: block;
		width: 100%;
		height: 100%;
		background-color: #fff;
		transform: translateX(-100%);
		transition: transform 0.45s ease;
	}

	.pricing__ask-link:hover .pricing__ask-underline-fill,
	.pricing__ask-link:focus-visible .pricing__ask-underline-fill {
		transform: translateX(0);
	}

	.pricing__ask-arrow {
		font-size: 0.9rem;
		line-height: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.pricing__cta,
		.pricing__ask-underline-fill {
			transition: none;
		}
	}

	@media (min-width: 48rem) {
		.pricing {
			padding-block: 5rem 8rem;
		}

		.pricing__title {
			font-size: 6.5rem;
			letter-spacing: -0.12rem;
		}

		.pricing__layout {
			grid-template-columns: 1fr 1fr;
			gap: 1rem;
			margin-top: 4rem;
		}

		.pricing__aside {
			grid-column: 1 / -1;
		}

		.pricing__plan {
			padding: 1.5rem;
		}

		.pricing__plan-price {
			font-size: 3.25rem;
			letter-spacing: -0.14rem;
		}

		.pricing__proof-value {
			font-size: 3.25rem;
			letter-spacing: -0.14rem;
		}

		.pricing__ask {
			margin-top: 1.5rem;
		}
	}

	@media (min-width: 64rem) {
		.pricing__inner {
			padding-inline: 2rem;
		}

		.pricing {
			padding-block: 6rem 10rem;
		}

		.pricing__title {
			font-size: 8.75rem;
			letter-spacing: -0.24rem;
		}

		.pricing__layout {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
			gap: 1.15rem;
			margin-top: 5rem;
		}

		.pricing__aside {
			grid-column: auto;
		}

		.pricing__ask {
			margin-top: auto;
			padding-top: 1.5rem;
		}

		.pricing__plan-price {
			font-size: 3.75rem;
			letter-spacing: -0.16rem;
		}

		.pricing__proof-value {
			font-size: 3.75rem;
			letter-spacing: -0.16rem;
		}

		.pricing__ask-link {
			font-size: 1rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	let destroyPricingMotion: (() => void) | undefined;

	function initPricingMotion() {
		destroyPricingMotion?.();

		const cleanups: Array<() => void> = [];
		const mm = gsap.matchMedia();
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const localCleanups: Array<() => void> = [];
			const header = document.querySelector('.pricing__header');
			const revealTargets = document.querySelectorAll('[data-pricing-reveal]');

			if (header instanceof HTMLElement && revealTargets.length > 0) {
				const split = SplitText.create(revealTargets, {
					type: 'lines',
					mask: 'lines',
					autoSplit: true,
					aria: 'auto',
					linesClass: 'pricing-reveal-line',
					onSplit(self) {
						return gsap.from(self.lines, {
							yPercent: 110,
							duration: 0.95,
							ease: 'power3.out',
							stagger: 0.12,
							scrollTrigger: {
								trigger: header,
								start: 'top 80%',
								once: true,
							},
						});
					},
				});

				localCleanups.push(() => split.revert());
			}

			document.querySelectorAll('[data-pricing-link-hover]').forEach((link) => {
				const tracks = link.querySelectorAll('.pricing__char-track');
				if (tracks.length === 0) return;

				gsap.set(tracks, { yPercent: 0 });

				let hoverTl: ReturnType<typeof gsap.to> | undefined;

				const playHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: -50,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				const resetHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: 0,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				link.addEventListener('mouseenter', playHover);
				link.addEventListener('mouseleave', resetHover);
				link.addEventListener('focus', playHover);
				link.addEventListener('blur', resetHover);

				localCleanups.push(() => {
					hoverTl?.kill();
					link.removeEventListener('mouseenter', playHover);
					link.removeEventListener('mouseleave', resetHover);
					link.removeEventListener('focus', playHover);
					link.removeEventListener('blur', resetHover);
				});
			});

			return () => {
				localCleanups.forEach((cleanup) => cleanup());
			};
		});

		document.querySelectorAll('[data-pricing-faq]').forEach((item) => {
			if (!(item instanceof HTMLElement)) return;

			const trigger = item.querySelector('[data-faq-trigger]');
			const panel = item.querySelector('[data-faq-panel]');
			const icon = item.querySelector('[data-faq-icon]');

			if (
				!(trigger instanceof HTMLButtonElement) ||
				!(panel instanceof HTMLElement) ||
				!(icon instanceof HTMLElement)
			) {
				return;
			}

			gsap.set(panel, { height: 0, overflow: 'hidden' });
			gsap.set(icon, { rotation: 0, transformOrigin: '50% 50%' });

			const setOpen = (open: boolean) => {
				trigger.setAttribute('aria-expanded', String(open));
				item.classList.toggle('is-open', open);

				const duration = reduceMotion ? 0 : 0.4;

				gsap.to(panel, {
					height: open ? 'auto' : 0,
					duration,
					ease: 'power3.inOut',
					overwrite: true,
				});

				gsap.to(icon, {
					rotation: open ? 45 : 0,
					duration: reduceMotion ? 0 : 0.35,
					ease: 'power3.out',
					overwrite: true,
					force3D: false,
				});
			};

			const onClick = () => {
				const isOpen = trigger.getAttribute('aria-expanded') === 'true';
				setOpen(!isOpen);
			};

			trigger.addEventListener('click', onClick);

			cleanups.push(() => {
				gsap.killTweensOf([panel, icon]);
				trigger.removeEventListener('click', onClick);
			});
		});

		destroyPricingMotion = () => {
			mm.revert();
			cleanups.forEach((cleanup) => cleanup());
			destroyPricingMotion = undefined;
		};
	}

	initPricingMotion();
	document.addEventListener('astro:after-swap', initPricingMotion);
</script>
