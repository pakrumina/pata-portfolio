---
import { VALUES_ITEMS, VALUES_TITLE } from '../consts';
import ValueGlyph from './ValueGlyph.astro';
---

<section class="values" id="values" aria-label="Our values">
	<div class="values__inner">
		<header class="values__header">
			<h2 class="values__title">
				<span class="values__title-lead" data-values-reveal>{VALUES_TITLE.lead}</span>
				<span class="values__title-main" data-values-reveal>{VALUES_TITLE.main}</span>
			</h2>
		</header>

		<div class="values__grid">
			{
				VALUES_ITEMS.map((item) => (
					<article class="values__card">
						<span class="values__icon" aria-hidden="true">
							<ValueGlyph id={item.id} />
						</span>
						<h3 class="values__name">{item.title}</h3>
						<p class="values__text">{item.text}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.values {
		width: 100%;
		padding-block: 4rem 5rem;
		background-color: var(--color-bg);
	}

	.values__inner {
		width: 100%;
		max-width: 100rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	.values__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.values__title {
		display: flex;
		flex-direction: column;
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 3.375rem;
		line-height: 1;
		letter-spacing: -0.06rem;
	}

	.values__title-main {
		color: #737373;
	}

	.values__title :global(.values-reveal-line) {
		padding-bottom: 0.08em;
	}

	.values__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.85rem;
		margin-top: 3rem;
	}

	.values__card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-width: 0;
		height: 100%;
		padding: 1.35rem 1.35rem 1.5rem;
		border: 0.0625rem solid rgb(245 245 245 / 0.14);
		border-radius: 1.875rem;
		background-color: #111;
	}

	.values__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3.25rem;
		height: 3.25rem;
		color: var(--color-fg);
	}

	.values__icon :global(svg) {
		display: block;
		width: 2.25rem;
		height: 2.25rem;
	}

	.values__name {
		margin: 1.15rem 0 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 1.75rem;
		line-height: 1.15;
		letter-spacing: -0.03rem;
	}

	.values__text {
		margin: 1.15rem 0 0;
		padding-top: 1.15rem;
		border-top: 0.0625rem solid rgb(245 245 245 / 0.12);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.9375rem;
		line-height: 1.55;
		letter-spacing: -0.01rem;
	}

	@media (min-width: 48rem) {
		.values {
			padding-block: 5rem 6rem;
		}

		.values__inner {
			padding-inline: 2rem;
		}

		.values__title {
			font-size: 6.5rem;
			letter-spacing: -0.12rem;
		}

		.values__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1rem;
			margin-top: 4rem;
		}

		.values__card {
			padding: 1.5rem;
		}
	}

	@media (min-width: 64rem) {
		.values {
			padding-block: 6rem 7rem;
		}

		.values__inner {
			padding-inline: 2.5rem;
		}

		.values__title {
			font-size: 8.75rem;
			letter-spacing: -0.24rem;
		}

		.values__card {
			padding: 1.75rem;
		}

		.values__name {
			margin-top: 1.35rem;
			font-size: 1.875rem;
		}

		.values__text {
			margin-top: 1.35rem;
			padding-top: 1.35rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	let destroyValuesMotion: (() => void) | undefined;

	function initValuesMotion() {
		destroyValuesMotion?.();

		const mm = gsap.matchMedia();
		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const header = document.querySelector('.values__header');
			const revealTargets = document.querySelectorAll('[data-values-reveal]');

			if (!(header instanceof HTMLElement) || revealTargets.length === 0) {
				return;
			}

			const split = SplitText.create(revealTargets, {
				type: 'lines',
				mask: 'lines',
				autoSplit: true,
				aria: 'auto',
				linesClass: 'values-reveal-line',
				onSplit(self) {
					return gsap.from(self.lines, {
						yPercent: 110,
						duration: 0.95,
						ease: 'power3.out',
						stagger: 0.12,
						scrollTrigger: {
							trigger: header,
							start: 'top 80%',
							once: true,
						},
					});
				},
			});

			return () => split.revert();
		});

		destroyValuesMotion = () => {
			mm.revert();
			destroyValuesMotion = undefined;
		};
	}

	initValuesMotion();
	document.addEventListener('astro:after-swap', initValuesMotion);
</script>
