---
import { SERVICES_PAGE_ITEMS, SERVICES_PAGE_LINK, SERVICES_PAGE_TITLE } from '../consts';

function charsOf(label: string) {
	return [...label].map((char) => (char === ' ' ? '\u00A0' : char));
}
---

<section class="offerings" id="services" aria-label="Services" data-offerings>
	<div class="offerings__inner">
		<header class="offerings__header">
			<h1 class="offerings__title">
				<span class="offerings__title-lead" data-offerings-reveal>{SERVICES_PAGE_TITLE.lead}</span>
				<span class="offerings__title-main" data-offerings-reveal>{SERVICES_PAGE_TITLE.main}</span>
			</h1>
			<a
				class="offerings__button"
				href={SERVICES_PAGE_LINK.href}
				data-offerings-link-hover
				aria-label={SERVICES_PAGE_LINK.label}
			>
				<span class="offerings__button-mask" aria-hidden="true">
					{
						charsOf(SERVICES_PAGE_LINK.label).map((char) => (
							<span class="offerings__char-col">
								<span class="offerings__char-track">
									<span class="offerings__char">{char}</span>
									<span class="offerings__char">{char}</span>
								</span>
							</span>
						))
					}
				</span>
			</a>
		</header>

		<ul class="offerings__grid">
			{
				SERVICES_PAGE_ITEMS.map((service) => (
					<li class="offerings__item">
						<article class="offerings__card">
							<div class="offerings__media">
								<img class="offerings__image" src={service.image} alt="" data-offerings-image />
							</div>
							<div class="offerings__body">
								<h2 class="offerings__name">{service.title}</h2>
								<div class="offerings__rule" aria-hidden="true"></div>
								<p class="offerings__text">{service.description}</p>
							</div>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.offerings {
		width: 100%;
		padding-block: 11rem 5rem;
		background-color: var(--color-bg);
	}

	.offerings__inner {
		width: 100%;
		max-width: 100rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	.offerings__header {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.5rem;
	}

	.offerings__title {
		display: flex;
		flex-direction: column;
		margin: 0;
		min-width: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 4.125rem;
		line-height: 0.95;
		letter-spacing: -0.06rem;
	}

	.offerings__title-main {
		color: #737373;
	}

	.offerings__title :global(.offerings-reveal-line) {
		padding-bottom: 0.08em;
	}

	.offerings__button {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		margin-bottom: 0.08em;
		padding: 0.9rem 1.6rem;
		border-radius: 999rem;
		background-color: #fff;
		color: #0a0a0a;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.9375rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
		text-decoration: none;
		isolation: isolate;
		transition: background-color 0.45s ease;
	}

	.offerings__button-mask {
		display: inline-flex;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.offerings__char-col {
		display: block;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.offerings__char-track {
		display: flex;
		flex-direction: column;
		will-change: transform;
	}

	.offerings__char {
		display: block;
		flex: 0 0 1.4em;
		height: 1.4em;
		line-height: 1.4;
	}

	.offerings__button:hover,
	.offerings__button:focus-visible {
		background-color: #f5f5f5;
		outline: none;
	}

	.offerings__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		margin: 3rem 0 0;
		padding: 0;
		list-style: none;
	}

	.offerings__item {
		min-width: 0;
	}

	.offerings__card {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 0.625rem;
		border: 0.0625rem solid rgb(245 245 245 / 0.14);
		border-radius: 1.875rem;
		background-color: transparent;
		transition: background-color 0.45s ease;
	}

	.offerings__card:hover {
		background-color: rgb(245 245 245 / 0.045);
	}

	.offerings__media {
		position: relative;
		isolation: isolate;
		width: 100%;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: 1.25rem;
		background-color: #000;
		transform: translateZ(0);
		-webkit-backface-visibility: hidden;
		backface-visibility: hidden;
		-webkit-mask-image: -webkit-radial-gradient(white, black);
		mask-image: radial-gradient(white, black);
		clip-path: inset(0 round 1.25rem);
	}

	.offerings__media::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		border: 0.0625rem solid rgb(245 245 245 / 0.14);
		border-radius: inherit;
		pointer-events: none;
	}

	.offerings__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		border-radius: inherit;
		-webkit-backface-visibility: hidden;
		backface-visibility: hidden;
		transform: translateZ(0);
	}

	.offerings__body {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		padding: 1.15rem 0.75rem 0.85rem;
	}

	.offerings__name {
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 1.25rem;
		line-height: 1.15;
		letter-spacing: -0.03rem;
	}

	.offerings__rule {
		width: 100%;
		height: 0.0625rem;
		background-color: rgb(245 245 245 / 0.12);
	}

	.offerings__text {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.9375rem;
		line-height: 1.55;
		letter-spacing: -0.01rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.offerings__button,
		.offerings__card {
			transition: none;
		}
	}

	@media (min-width: 48rem) {
		.offerings {
			padding-block: 12rem 6rem;
		}

		.offerings__inner {
			padding-inline: 2rem;
		}

		.offerings__header {
			flex-direction: row;
			align-items: flex-end;
			justify-content: space-between;
		}

		.offerings__title {
			font-size: 6.5rem;
			letter-spacing: -0.12rem;
		}

		.offerings__button {
			padding: 1rem 1.85rem;
			font-size: 1rem;
		}

		.offerings__grid {
			grid-template-columns: 1fr 1fr;
			gap: 1.5rem;
			margin-top: 4rem;
		}

		.offerings__body {
			gap: 1rem;
			padding: 1.35rem 0.9rem 1rem;
		}

		.offerings__name {
			font-size: 1.375rem;
		}

		.offerings__text {
			font-size: 1rem;
		}
	}

	@media (min-width: 64rem) {
		.offerings {
			padding-block: 13rem 7rem;
		}

		.offerings__inner {
			padding-inline: 2.5rem;
		}

		.offerings__title {
			font-size: 8.75rem;
			letter-spacing: -0.24rem;
		}

		.offerings__button {
			padding: 1.05rem 2.1rem;
			font-size: 1.0625rem;
		}

		.offerings__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.75rem;
			margin-top: 5rem;
		}

		.offerings__name {
			font-size: 1.5rem;
			letter-spacing: -0.04rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	let destroyOfferingsMotion: (() => void) | undefined;

	function initOfferingsMotion() {
		destroyOfferingsMotion?.();

		const section = document.querySelector('[data-offerings]');
		if (!(section instanceof HTMLElement)) return;

		const mm = gsap.matchMedia();
		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const cleanups: Array<() => void> = [];
			const header = section.querySelector('.offerings__header');
			const revealTargets = section.querySelectorAll('[data-offerings-reveal]');

			if (header instanceof HTMLElement && revealTargets.length > 0) {
				const split = SplitText.create(revealTargets, {
					type: 'lines',
					mask: 'lines',
					autoSplit: true,
					aria: 'auto',
					linesClass: 'offerings-reveal-line',
					onSplit(self) {
						return gsap.from(self.lines, {
							yPercent: 110,
							duration: 0.95,
							ease: 'power3.out',
							stagger: 0.12,
							scrollTrigger: {
								trigger: header,
								start: 'top 80%',
								once: true,
							},
						});
					},
				});

				cleanups.push(() => split.revert());
			}

			section.querySelectorAll('[data-offerings-link-hover]').forEach((link) => {
				const tracks = link.querySelectorAll('.offerings__char-track');
				if (tracks.length === 0) return;

				gsap.set(tracks, { yPercent: 0 });

				let hoverTl: ReturnType<typeof gsap.to> | undefined;

				const playHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: -50,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				const resetHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: 0,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				link.addEventListener('mouseenter', playHover);
				link.addEventListener('mouseleave', resetHover);
				link.addEventListener('focus', playHover);
				link.addEventListener('blur', resetHover);

				cleanups.push(() => {
					hoverTl?.kill();
					link.removeEventListener('mouseenter', playHover);
					link.removeEventListener('mouseleave', resetHover);
					link.removeEventListener('focus', playHover);
					link.removeEventListener('blur', resetHover);
				});
			});

			section.querySelectorAll<HTMLElement>('[data-offerings-image]').forEach((image) => {
				const media = image.closest('.offerings__media');
				if (!(media instanceof HTMLElement)) return;

				gsap.fromTo(
					image,
					{ yPercent: -4, scale: 1.08 },
					{
						yPercent: 4,
						scale: 1.08,
						ease: 'none',
						force3D: false,
						scrollTrigger: {
							trigger: media,
							start: 'top bottom',
							end: 'bottom top',
							scrub: 0.7,
						},
					},
				);
			});

			return () => {
				cleanups.forEach((cleanup) => cleanup());
			};
		});

		destroyOfferingsMotion = () => {
			mm.revert();
			destroyOfferingsMotion = undefined;
		};
	}

	initOfferingsMotion();
	document.addEventListener('astro:after-swap', initOfferingsMotion);
</script>
