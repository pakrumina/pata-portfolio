---
import { WORK_PROCESS_NOTE, WORK_PROCESS_STEPS, WORK_PROCESS_TITLE } from '../consts';
---

<section class="process" id="process" aria-label="Our work process">
	<div class="process__inner">
		<header class="process__header">
			<h2 class="process__title">
				<span class="process__title-lead" data-process-reveal>{WORK_PROCESS_TITLE.lead}</span>
				<span class="process__title-main" data-process-reveal>{WORK_PROCESS_TITLE.main}</span>
			</h2>
			<p class="process__note" data-process-reveal>{WORK_PROCESS_NOTE}</p>
		</header>

		<div class="process__grid">
			{
				WORK_PROCESS_STEPS.map((step) => (
					<article class="process__card">
						<p class="process__label">
							<span class="process__mark" aria-hidden="true">
								✦
							</span>
							{step.label}
						</p>
						<p class="process__index">{step.index}</p>
						<p class="process__text">{step.text}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.process {
		width: 100%;
		padding-block: 4rem 5rem;
		background-color: var(--color-bg);
	}

	.process__inner {
		width: 100%;
		max-width: 100rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	.process__header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.25rem 2.5rem;
	}

	.process__title {
		display: flex;
		flex-direction: column;
		margin: 0;
		min-width: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 3.375rem;
		line-height: 1;
		letter-spacing: -0.06rem;
	}

	.process__title-main {
		color: #737373;
	}

	.process__title :global(.process-reveal-line) {
		padding-bottom: 0.08em;
	}

	.process__note {
		flex: 1 1 16rem;
		max-width: 24rem;
		margin: 0 0 0.08em auto;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.9375rem;
		line-height: 1.55;
		letter-spacing: -0.01rem;
	}

	.process__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.85rem;
		margin-top: 3rem;
	}

	.process__card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		height: 100%;
		padding: 1.35rem 1.35rem 1.5rem;
		border: 0.0625rem solid rgb(245 245 245 / 0.14);
		border-radius: 1.875rem;
		background-color: #111;
	}

	.process__label {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.75rem;
		line-height: 1;
		letter-spacing: 0.08rem;
		text-transform: uppercase;
	}

	.process__mark {
		font-size: 0.7rem;
		line-height: 1;
	}

	.process__index {
		margin: 1.35rem 0 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 4.5rem;
		line-height: 0.9;
		letter-spacing: -0.12rem;
	}

	.process__text {
		margin: 1.35rem 0 0;
		padding-top: 1.35rem;
		border-top: 0.0625rem solid rgb(245 245 245 / 0.12);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.9375rem;
		line-height: 1.55;
		letter-spacing: -0.01rem;
	}

	@media (min-width: 48rem) {
		.process {
			padding-block: 5rem 6rem;
		}

		.process__inner {
			padding-inline: 2rem;
		}

		.process__title {
			font-size: 6.5rem;
			letter-spacing: -0.12rem;
		}

		.process__note {
			flex: 0 0 20rem;
			max-width: 20rem;
			font-size: 1rem;
		}

		.process__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1rem;
			margin-top: 4rem;
		}

		.process__card {
			padding: 1.5rem;
		}

		.process__index {
			font-size: 5.5rem;
			letter-spacing: -0.16rem;
		}
	}

	@media (min-width: 64rem) {
		.process {
			padding-block: 6rem 7rem;
		}

		.process__inner {
			padding-inline: 2.5rem;
		}

		.process__title {
			font-size: 8.75rem;
			letter-spacing: -0.24rem;
		}

		.process__note {
			flex: 0 0 22rem;
			max-width: 22rem;
			font-size: 1.125rem;
		}

		.process__card {
			padding: 1.75rem;
		}

		.process__index {
			margin-top: 1.75rem;
			font-size: 7.5rem;
			letter-spacing: -0.2rem;
		}

		.process__text {
			margin-top: 1.75rem;
			padding-top: 1.75rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	let destroyProcessMotion: (() => void) | undefined;

	function initProcessMotion() {
		destroyProcessMotion?.();

		const mm = gsap.matchMedia();
		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const header = document.querySelector('.process__header');
			const revealTargets = document.querySelectorAll('[data-process-reveal]');

			if (!(header instanceof HTMLElement) || revealTargets.length === 0) {
				return;
			}

			const split = SplitText.create(revealTargets, {
				type: 'lines',
				mask: 'lines',
				autoSplit: true,
				aria: 'auto',
				linesClass: 'process-reveal-line',
				onSplit(self) {
					return gsap.from(self.lines, {
						yPercent: 110,
						duration: 0.95,
						ease: 'power3.out',
						stagger: 0.12,
						scrollTrigger: {
							trigger: header,
							start: 'top 80%',
							once: true,
						},
					});
				},
			});

			return () => split.revert();
		});

		destroyProcessMotion = () => {
			mm.revert();
			destroyProcessMotion = undefined;
		};
	}

	initProcessMotion();
	document.addEventListener('astro:after-swap', initProcessMotion);
</script>
