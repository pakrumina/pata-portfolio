---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
	heading?: 'h2' | 'h3';
}

const { post, heading: Heading = 'h2' } = Astro.props;
---

<a class="blog-card" href={`/blog/${post.id}`}>
	<div class="blog-card__media">
		<img class="blog-card__image" src={post.data.image} alt="" data-blog-image />
		<span class="blog-card__tag">{post.data.category}</span>
		<span class="blog-card__pointer" aria-hidden="true">
			<svg viewBox="0 0 16 16" fill="none">
				<path
					d="M4 12L12 4M12 4H6.5M12 4V9.5"
					stroke="currentColor"
					stroke-width="1.4"
					stroke-linecap="round"
					stroke-linejoin="round"
				></path>
			</svg>
		</span>
	</div>
	<div class="blog-card__body">
		<Heading class="blog-card__title">{post.data.title}</Heading>
		<p class="blog-card__text">{post.data.description}</p>
	</div>
</a>

<style>
	.blog-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 0.625rem;
		border: 0.0625rem solid rgb(245 245 245 / 0.14);
		border-radius: 1.875rem;
		background-color: transparent;
		color: inherit;
		text-decoration: none;
		transition: background-color 0.45s ease;
	}

	.blog-card:hover,
	.blog-card:focus-visible {
		background-color: rgb(245 245 245 / 0.045);
		outline: none;
	}

	.blog-card__media {
		position: relative;
		isolation: isolate;
		z-index: 0;
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 1.25rem;
		background-color: #111;
		transform: translateZ(0);
		-webkit-backface-visibility: hidden;
		backface-visibility: hidden;
		-webkit-mask-image: -webkit-radial-gradient(white, black);
		mask-image: radial-gradient(white, black);
		clip-path: inset(0 round 1.25rem);
	}

	.blog-card__media::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: inherit;
		background-color: rgb(10 10 10 / 0.38);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.45s ease;
	}

	.blog-card:hover .blog-card__media::after,
	.blog-card:focus-visible .blog-card__media::after {
		opacity: 1;
	}

	.blog-card__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		border-radius: inherit;
		-webkit-backface-visibility: hidden;
		backface-visibility: hidden;
		transform: scale(1);
		transition: transform 0.55s ease;
		will-change: transform;
	}

	.blog-card:hover .blog-card__image,
	.blog-card:focus-visible .blog-card__image {
		transform: scale(1.1);
	}

	.blog-card__pointer {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 3;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 0.0625rem solid rgb(245 245 245 / 0.28);
		border-radius: 999rem;
		background-color: #fff;
		color: #0a0a0a;
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, -50%) scale(0.7);
		transition:
			opacity 0.45s ease,
			transform 0.45s ease;
	}

	.blog-card__pointer svg {
		display: block;
		width: 0.75rem;
		height: 0.75rem;
	}

	.blog-card:hover .blog-card__pointer,
	.blog-card:focus-visible .blog-card__pointer {
		opacity: 1;
		transform: translate(-50%, -50%) scale(1);
	}

	.blog-card__tag {
		position: absolute;
		top: 0.85rem;
		left: 0.85rem;
		z-index: 2;
		padding: 0.4rem 0.8rem;
		border-radius: 999rem;
		background-color: #0a0a0a;
		color: #fff;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.6875rem;
		line-height: 1;
		letter-spacing: 0.06rem;
		text-transform: uppercase;
	}

	.blog-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		padding: 1.15rem 0.75rem 0.85rem;
	}

	.blog-card__title {
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 1.25rem;
		line-height: 1.2;
		letter-spacing: -0.03rem;
	}

	.blog-card__text {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.9375rem;
		line-height: 1.55;
		letter-spacing: -0.01rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.blog-card,
		.blog-card__image,
		.blog-card__media::after,
		.blog-card__pointer {
			transition: none;
		}

		.blog-card:hover .blog-card__image,
		.blog-card:focus-visible .blog-card__image {
			transform: none;
		}
	}

	@media (min-width: 48rem) {
		.blog-card__pointer {
			width: 2.75rem;
			height: 2.75rem;
		}

		.blog-card__pointer svg {
			width: 0.875rem;
			height: 0.875rem;
		}

		.blog-card__body {
			padding: 1.35rem 0.9rem 1rem;
		}

		.blog-card__title {
			font-size: 1.375rem;
		}

		.blog-card__text {
			font-size: 1rem;
		}
	}

	@media (min-width: 64rem) {
		.blog-card__title {
			font-size: 1.5rem;
			letter-spacing: -0.04rem;
		}
	}
</style>
