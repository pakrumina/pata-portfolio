---
import HeroBar from './HeroBar.astro';
import HeroTrail from './HeroTrail.astro';

interface Props {
	kicker: string;
	titleLead: string;
	titleMain: string;
	description: string;
}

const { kicker, titleLead, titleMain, description } = Astro.props;
---

<header class="hero hero-section" data-hero>
	<div class="hero__media">
		<video class="hero__video" autoplay muted loop playsinline aria-hidden="true">
			<source src="/header-background-video.mp4" type="video/mp4" />
		</video>
		<div class="hero__overlay" aria-hidden="true"></div>
	</div>
	<div class="hero__copy">
		<h1 class="hero__title">
			<span class="hero__title-line">{titleLead}</span>
			<span class="hero__title-line">{titleMain}</span>
		</h1>
		<p class="hero__description">{description}</p>
	</div>
	<HeroTrail />
	<div class="hero__fade" aria-hidden="true"></div>
	<HeroBar />
</header>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		width: 100%;
		height: 95vh;
		overflow: hidden;
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero__overlay {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		background-color: var(--color-bg);
		opacity: 0.65;
	}

	.hero__fade {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 5;
		height: 10rem;
		pointer-events: none;
		background-image: linear-gradient(to bottom, transparent, var(--color-bg));
	}

	.hero__copy {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		padding-inline: 1.25rem;
		pointer-events: none;
	}

	.hero__kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0.65rem 0.85rem;
		border: 0.0625rem solid rgb(255 255 255 / 0.16);
		border-radius: 999rem;
		background-color: rgb(255 255 255 / 0.06);
		color: #fff;
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.625rem;
		line-height: 1;
		letter-spacing: 0.08rem;
		text-transform: uppercase;
	}

	.hero__kicker-mark {
		font-size: 0.55rem;
		line-height: 1;
	}

	.hero__title {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin: 0;
		color: #000;
		font-family: var(--font-sans);
		font-weight: 900;
		font-size: 4.375rem;
		line-height: 0.9;
		letter-spacing: -0.04rem;
		text-align: center;
		text-transform: uppercase;
	}

	.hero__title-line {
		display: block;
	}

	.hero__description {
		margin: 0;
		color: #000;
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 1.125rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
		text-align: center;
		text-size-adjust: 100%;
		-webkit-text-size-adjust: 100%;
	}

	@media (max-width: 47.999rem) {
		.hero__description {
			font-size: 1.125rem;
		}
	}

	@media (min-width: 48rem) {
		.hero {
			height: 100vh;
		}

		.hero__copy {
			gap: 1.75rem;
		}

		.hero__kicker {
			font-size: 0.75rem;
		}

		.hero__title {
			font-size: 7.5rem;
		}
	}

	@media (min-width: 48rem) and (max-width: 63.999rem) {
		.hero__description {
			font-size: 1.25rem;
		}
	}

	@media (min-width: 64rem) {
		.hero__title {
			font-size: 12rem;
		}

		.hero__description {
			font-size: 1.25rem;
		}
	}
</style>
