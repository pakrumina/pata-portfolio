---
import { SERVICES_ITEMS, SERVICES_LINK, SERVICES_TITLE } from '../consts';

function charsOf(label: string) {
	return [...label].map((char) => (char === ' ' ? '\u00A0' : char));
}
---

<section class="services" id="services" aria-label="Services">
	<div class="services__inner">
		<header class="services__header">
			<h2 class="services__title">
				<span class="services__title-lead" data-services-reveal>{SERVICES_TITLE.lead}</span>
				<span class="services__title-main" data-services-reveal>{SERVICES_TITLE.main}</span>
			</h2>
		</header>

		<div class="services__layout">
			<div class="services__list">
				{
					SERVICES_ITEMS.map((service, index) => (
						<article
							class:list={['services__item', { 'is-active': index === 0 }]}
							data-services-item
						>
							<div class="services__item-head">
								<div class="services__item-heading">
									<span class="services__item-index" aria-hidden="true">
										{String(index + 1).padStart(2, '0')}
									</span>
									<h3 class="services__item-title">
										{
											service.title.split(' ').map((word) => (
												<span class="services__item-word">{word}</span>
											))
										}
									</h3>
								</div>
								<div class="services__thumb">
									<img src={service.image} alt="" />
								</div>
							</div>
							<div class="services__item-rule" aria-hidden="true"></div>
							<p class="services__item-text">{service.description}</p>
							<a
								class="services__link"
								href={SERVICES_LINK.href}
								data-services-link-hover
								aria-label={`${SERVICES_LINK.label}: ${service.title}`}
							>
								<span class="services__link-mask" aria-hidden="true">
									{
										charsOf(SERVICES_LINK.label).map((char) => (
											<span class="services__char-col">
												<span class="services__char-track">
													<span class="services__char">{char}</span>
													<span class="services__char">{char}</span>
												</span>
											</span>
										))
									}
								</span>
								<span class="services__link-arrow" aria-hidden="true">↗</span>
								<span class="services__link-underline" aria-hidden="true">
									<span class="services__link-underline-fill"></span>
								</span>
							</a>
						</article>
					))
				}
			</div>

			<aside class="services__media" aria-hidden="true">
				<div class="services__stage">
					<div class="services__frame">
						{
							SERVICES_ITEMS.map((service, index) => (
								<img
									class:list={['services__image', { 'is-active': index === 0 }]}
									src={service.image}
									alt=""
									data-services-image
								/>
							))
						}
					</div>
				</div>
			</aside>
		</div>
	</div>
</section>

<style>
	.services {
		width: 100%;
		padding-block: 4rem 8rem;
		background-color: var(--color-bg);
	}

	.services__inner {
		width: 100%;
		max-width: 100rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	.services__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.services__title {
		display: flex;
		flex-direction: column;
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 3.375rem;
		line-height: 1;
		letter-spacing: -0.06rem;
	}

	.services__title-main {
		color: #737373;
	}

	.services__title :global(.services-reveal-line) {
		padding-bottom: 0.08em;
	}

	.services__layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		margin-top: 3rem;
	}

	.services__list {
		display: flex;
		flex-direction: column;
		gap: 2.75rem;
		min-width: 0;
	}

	.services__item {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0;
	}

	.services__item-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
	}

	.services__item-heading {
		--heading-size: 4rem;
		display: flex;
		align-items: center;
		gap: 1.4rem;
		min-width: 0;
		font-size: var(--heading-size);
	}

	.services__item-index {
		flex: 0 0 auto;
		color: rgb(255 255 255 / 0.1);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: var(--heading-size);
		line-height: 1;
		letter-spacing: calc(var(--heading-size) * -0.04);
		font-variant-numeric: tabular-nums;
	}

	.services__thumb {
		box-sizing: border-box;
		flex: 0 0 4rem;
		width: 4rem;
		height: 4rem;
		padding: 0.25rem;
		overflow: hidden;
		border: 0.0625rem solid rgb(245 245 245 / 0.14);
		border-radius: 0.85rem;
		background-color: transparent;
	}

	.services__thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		border-radius: 0.55rem;
		background-color: #000;
	}

	.services__item-title {
		display: flex;
		flex-direction: column;
		margin: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: calc(var(--heading-size) * 0.5 - 0.25rem);
		line-height: 1;
		letter-spacing: -0.03rem;
	}

	.services__item-word {
		display: block;
	}

	.services__item-rule {
		width: 100%;
		max-width: 38rem;
		height: 0.0625rem;
		margin-block: 2.5rem;
		border: 0;
		background-color: rgb(245 245 245 / 0.16);
	}

	.services__item-text {
		margin: 0;
		max-width: 38rem;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 1rem;
		line-height: 1.55;
		letter-spacing: -0.01rem;
	}

	.services__link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		width: fit-content;
		margin-top: 1rem;
		border-bottom: 0.0625rem solid rgb(245 245 245 / 0.35);
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 1rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
		text-decoration: none;
	}

	.services__link-mask {
		display: inline-flex;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.services__char-col {
		display: block;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.services__char-track {
		display: flex;
		flex-direction: column;
		will-change: transform;
	}

	.services__char {
		display: block;
		flex: 0 0 1.4em;
		height: 1.4em;
		line-height: 1.4;
	}

	.services__link-underline {
		position: absolute;
		right: 0;
		bottom: -0.0625rem;
		left: 0;
		height: 0.0625rem;
		overflow: hidden;
		pointer-events: none;
	}

	.services__link-underline-fill {
		display: block;
		width: 100%;
		height: 100%;
		background-color: #fff;
		transform: translateX(-100%);
		transition: transform 0.45s ease;
	}

	.services__link:hover .services__link-underline-fill,
	.services__link:focus-visible .services__link-underline-fill {
		transform: translateX(0);
	}

	.services__link-arrow {
		font-size: 0.9rem;
		line-height: 1;
	}

	.services__media {
		display: none;
	}

	@media (min-width: 48rem) {
		.services {
			padding-block: 5rem 8rem;
		}

		.services__title {
			font-size: 6.5rem;
			letter-spacing: -0.12rem;
		}

		.services__layout {
			margin-top: 4rem;
		}

		.services__list {
			gap: 3.25rem;
		}

		.services__thumb {
			flex-basis: 5.75rem;
			width: 5.75rem;
			height: 5.75rem;
		}

		.services__item-heading {
			--heading-size: 5.75rem;
			gap: 1.5rem;
		}

		.services__item-title {
			letter-spacing: -0.04rem;
		}
	}

	@media (min-width: 64rem) {
		.services__inner {
			padding-inline: 2rem;
		}

		.services {
			padding-block: 6rem 10rem;
		}

		.services__title {
			font-size: 8.75rem;
			letter-spacing: -0.24rem;
		}

		.services__layout {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			align-items: start;
			gap: 4rem;
			margin-top: 5rem;
		}

		.services__list {
			gap: 0;
		}

		.services__item {
			width: 100%;
			max-width: 36rem;
			min-height: 80vh;
			justify-content: center;
			gap: 0;
			opacity: 0.28;
			transition: opacity 0.55s ease;
		}

		.services__item.is-active {
			opacity: 1;
		}

		.services__thumb {
			display: none;
		}

		.services__item-heading {
			--heading-size: 8.5rem;
			gap: 1.6rem;
		}

		.services__item-title {
			letter-spacing: -0.1rem;
		}

		.services__item-text {
			max-width: 28rem;
			font-size: 1.0625rem;
		}

		.services__item-rule {
			max-width: 28rem;
		}

		.services__media {
			display: block;
			position: sticky;
			top: 6rem;
			width: 100%;
		}

		.services__stage {
			width: 100%;
			padding: 0.625rem;
			border: 0.0625rem solid rgb(245 245 245 / 0.14);
			border-radius: 1.875rem;
			background-color: transparent;
		}

		.services__frame {
			position: relative;
			width: 100%;
			aspect-ratio: 1;
			overflow: hidden;
			border-radius: 1.25rem;
			background-color: #000;
		}

		.services__image {
			position: absolute;
			inset: 0;
			display: block;
			width: 100%;
			height: 100%;
			object-fit: contain;
			object-position: center;
			opacity: 0;
			visibility: hidden;
		}

		.services__image.is-active {
			opacity: 1;
			visibility: visible;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.services__item,
		.services__link-underline-fill,
		.services__image {
			transition: none;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	let destroyServicesMotion: (() => void) | undefined;

	function initServicesMotion() {
		destroyServicesMotion?.();

		const mm = gsap.matchMedia();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const cleanups: Array<() => void> = [];
			const header = document.querySelector('.services__header');
			const revealTargets = document.querySelectorAll('[data-services-reveal]');

			if (header instanceof HTMLElement && revealTargets.length > 0) {
				const split = SplitText.create(revealTargets, {
					type: 'lines',
					mask: 'lines',
					autoSplit: true,
					aria: 'auto',
					linesClass: 'services-reveal-line',
					onSplit(self) {
						return gsap.from(self.lines, {
							yPercent: 110,
							duration: 0.95,
							ease: 'power3.out',
							stagger: 0.12,
							scrollTrigger: {
								trigger: header,
								start: 'top 80%',
								once: true,
							},
						});
					},
				});

				cleanups.push(() => split.revert());
			}

			document.querySelectorAll('[data-services-link-hover]').forEach((link) => {
				const tracks = link.querySelectorAll('.services__char-track');
				if (tracks.length === 0) return;

				gsap.set(tracks, { yPercent: 0 });

				let hoverTl: ReturnType<typeof gsap.to> | undefined;

				const playHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: -50,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				const resetHover = () => {
					hoverTl?.kill();
					hoverTl = gsap.to(tracks, {
						yPercent: 0,
						duration: 0.35,
						ease: 'power3.out',
						stagger: 0.03,
						overwrite: true,
					});
				};

				link.addEventListener('mouseenter', playHover);
				link.addEventListener('mouseleave', resetHover);
				link.addEventListener('focus', playHover);
				link.addEventListener('blur', resetHover);

				cleanups.push(() => {
					hoverTl?.kill();
					link.removeEventListener('mouseenter', playHover);
					link.removeEventListener('mouseleave', resetHover);
					link.removeEventListener('focus', playHover);
					link.removeEventListener('blur', resetHover);
				});
			});

			return () => {
				cleanups.forEach((cleanup) => cleanup());
			};
		});

		mm.add('(min-width: 64rem)', () => {
			const list = document.querySelector('.services__list');
			const items = document.querySelectorAll<HTMLElement>('[data-services-item]');
			const images = document.querySelectorAll<HTMLElement>('[data-services-image]');

			if (!(list instanceof HTMLElement) || items.length === 0 || images.length === 0) {
				return;
			}

			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const fadeDuration = reduceMotion ? 0 : 0.55;
			let activeIndex = 0;

			gsap.set(images, { autoAlpha: 0 });
			gsap.set(images[0], { autoAlpha: 1 });

			const setActive = (index: number) => {
				if (index === activeIndex) return;
				activeIndex = index;

				items.forEach((item, i) => {
					item.classList.toggle('is-active', i === index);
				});

				images.forEach((image, i) => {
					gsap.to(image, {
						autoAlpha: i === index ? 1 : 0,
						duration: fadeDuration,
						ease: 'power2.out',
						overwrite: true,
					});
				});
			};

			ScrollTrigger.create({
				trigger: list,
				start: 'top center',
				end: 'bottom center',
				onUpdate: (self) => {
					const nextIndex = Math.min(
						items.length - 1,
						Math.max(0, Math.round(self.progress * (items.length - 1))),
					);
					setActive(nextIndex);
				},
			});
		});

		destroyServicesMotion = () => {
			mm.revert();
			destroyServicesMotion = undefined;
		};
	}

	initServicesMotion();
	document.addEventListener('astro:after-swap', initServicesMotion);
</script>
