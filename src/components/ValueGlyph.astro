---
interface Props {
	id: string;
}

const { id } = Astro.props;
---

{
	id === 'purpose' && (
		<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.4"></circle>
			<circle cx="12" cy="12" r="3.25" stroke="currentColor" stroke-width="1.4"></circle>
			<path d="M12 2.75v2.5M12 18.75v2.5M2.75 12h2.5M18.75 12h2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
		</svg>
	)
}
{
	id === 'craft' && (
		<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<path
				d="M14.5 4.75 19.25 9.5 9.5 19.25H4.75V14.5L14.5 4.75Z"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linejoin="round"
			></path>
			<path d="M12.75 6.5 17.5 11.25" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
		</svg>
	)
}
{
	id === 'clarity' && (
		<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<path
				d="M3.5 12s3.25-6.25 8.5-6.25S20.5 12 20.5 12s-3.25 6.25-8.5 6.25S3.5 12 3.5 12Z"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linejoin="round"
			></path>
			<circle cx="12" cy="12" r="2.5" stroke="currentColor" stroke-width="1.4"></circle>
		</svg>
	)
}
{
	id === 'collaboration' && (
		<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<circle cx="8" cy="8.5" r="2.5" stroke="currentColor" stroke-width="1.4"></circle>
			<circle cx="16.5" cy="8.5" r="2.5" stroke="currentColor" stroke-width="1.4"></circle>
			<path
				d="M4.75 18.25c.35-2.4 2.15-4 4.25-4s3.9 1.6 4.25 4M10.75 18.25c.35-2.4 2.15-4 4.25-4s3.9 1.6 4.25 4"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linecap="round"
			></path>
		</svg>
	)
}
{
	id === 'consistency' && (
		<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<rect x="4.75" y="4.75" width="6.5" height="6.5" rx="0.8" stroke="currentColor" stroke-width="1.4"></rect>
			<rect x="12.75" y="4.75" width="6.5" height="6.5" rx="0.8" stroke="currentColor" stroke-width="1.4"></rect>
			<rect x="4.75" y="12.75" width="6.5" height="6.5" rx="0.8" stroke="currentColor" stroke-width="1.4"></rect>
			<rect x="12.75" y="12.75" width="6.5" height="6.5" rx="0.8" stroke="currentColor" stroke-width="1.4"></rect>
		</svg>
	)
}
{
	id === 'curiosity' && (
		<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<circle cx="11" cy="11" r="6.25" stroke="currentColor" stroke-width="1.4"></circle>
			<path d="M15.75 15.75 20 20" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
			<path d="M11 8.25v.15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
			<path d="M11 11.1v3.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
		</svg>
	)
}
